{% doc %}
  @prompt
    Create a premium dark Contact / Free Consultation section for Shopify Horizon matching my reference image. Use a large rounded black container with a subtle orange-to-purple gradient border and 2 columns on desktop, stacked on mobile.
    
    Left column: editable consultation badge, large heading with separately editable orange highlighted text, description, repeatable benefit blocks with glowing purple SVG icons, and an editable CTA button.
    
    Right column: native Shopify {% form 'contact' %} with Name, Email, Phone, Service dropdown, Message, and full-width purple-to-orange gradient submit button. Below add repeatable statistic blocks with glowing icons, value and label.
    
    Make EVERYTHING editable in Theme Editor: text, colors, font sizes, spacing, widths, padding, borders, radius, background/decorative image, buttons, field labels/placeholders, show/hide fields, service options, benefits and statistics. Use section blocks where needed. Fully responsive, accessible, Horizon-compatible, scoped CSS, no external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background }};
    position: relative;
    overflow: hidden;
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background: {{ block.settings.container_background }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-contact-container-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: {{ block.settings.gradient_border_width }}px;
    background: linear-gradient(
      {{ block.settings.gradient_angle }}deg,
      {{ block.settings.gradient_color_1 }},
      {{ block.settings.gradient_color_2 }}
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  {% if block.settings.background_image %}
    .ai-contact-container-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      opacity: {{ block.settings.background_image_opacity | divided_by: 100.0 }};
      pointer-events: none;
      border-radius: {{ block.settings.container_border_radius }}px;
    }
  {% endif %}

  .ai-contact-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  @media (min-width: 750px) {
    .ai-contact-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-contact-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.left_content_gap }}px;
  }

  .ai-contact-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    width: fit-content;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0;
    font-weight: 700;
  }

  .ai-contact-heading-{{ ai_gen_id }} .highlight {
    color: {{ block.settings.highlight_color }};
  }

  .ai-contact-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-contact-benefits-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.benefits_gap }}px;
  }

  .ai-contact-benefit-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.benefit_icon_gap }}px;
  }

  .ai-contact-benefit-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.benefit_icon_size }}px;
    height: {{ block.settings.benefit_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 {{ block.settings.icon_glow_intensity }}px {{ block.settings.benefit_icon_color }});
  }

  .ai-contact-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.benefit_icon_color }};
    stroke-width: 2;
  }

  .ai-contact-benefit-text-{{ ai_gen_id }} {
    color: {{ block.settings.benefit_text_color }};
    font-size: {{ block.settings.benefit_text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-contact-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    border: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-contact-cta-{{ ai_gen_id }}:hover {
    background: {{ block.settings.cta_hover_background }};
    transform: translateY(-2px);
  }

  .ai-contact-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.right_content_gap }}px;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    background: {{ block.settings.form_background }};
    border-radius: {{ block.settings.form_border_radius }}px;
    padding: {{ block.settings.form_padding }}px;
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.form_field_gap }}px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 500;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-select-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    background: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_font_size }}px;
    font-family: inherit;
  }

  .ai-contact-form-input-{{ ai_gen_id }}::placeholder,
  .ai-contact-form-textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-select-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: {{ block.settings.textarea_height }}px;
    resize: vertical;
  }

  .ai-contact-form-submit-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.submit_padding_vertical }}px {{ block.settings.submit_padding_horizontal }}px;
    background: linear-gradient(
      {{ block.settings.submit_gradient_angle }}deg,
      {{ block.settings.submit_gradient_color_1 }},
      {{ block.settings.submit_gradient_color_2 }}
    );
    color: {{ block.settings.submit_text_color }};
    border: none;
    border-radius: {{ block.settings.submit_border_radius }}px;
    font-size: {{ block.settings.submit_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-contact-form-submit-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  .ai-contact-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: {{ block.settings.stats_gap }}px;
  }

  .ai-contact-stat-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.stat_content_gap }}px;
    text-align: center;
  }

  .ai-contact-stat-icon-{{ ai_gen_id }} {
    width: {{ block.settings.stat_icon_size }}px;
    height: {{ block.settings.stat_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 {{ block.settings.stat_icon_glow }}px {{ block.settings.stat_icon_color }});
  }

  .ai-contact-stat-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.stat_icon_color }};
    stroke-width: 2;
  }

  .ai-contact-stat-value-{{ ai_gen_id }} {
    color: {{ block.settings.stat_value_color }};
    font-size: {{ block.settings.stat_value_size }}px;
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .ai-contact-stat-label-{{ ai_gen_id }} {
    color: {{ block.settings.stat_label_color }};
    font-size: {{ block.settings.stat_label_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  .ai-contact-form-message-{{ ai_gen_id }} {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .ai-contact-form-message-{{ ai_gen_id }}.success {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .ai-contact-form-message-{{ ai_gen_id }}.error {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  @media (max-width: 749px) {
    .ai-contact-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-contact-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding_mobile }}px;
    }

    .ai-contact-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-contact-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }
  }
{% endstyle %}

<contact-section-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <div class="ai-contact-content-{{ ai_gen_id }}">
      <div class="ai-contact-left-{{ ai_gen_id }}">
        {% if block.settings.show_badge and block.settings.badge_text != blank %}
          <div class="ai-contact-badge-{{ ai_gen_id }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            {{ block.settings.badge_text }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-contact-heading-{{ ai_gen_id }}">
            {{ block.settings.heading_before_highlight }}
            {% if block.settings.heading_highlight != blank %}
              <span class="highlight">{{ block.settings.heading_highlight }}</span>
            {% endif %}
            {{ block.settings.heading_after_highlight }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-contact-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        {% if block.settings.show_benefits %}
          <div class="ai-contact-benefits-{{ ai_gen_id }}">
            {% for benefit_block in block.settings.benefits %}
              <div class="ai-contact-benefit-{{ ai_gen_id }}">
                <div class="ai-contact-benefit-icon-{{ ai_gen_id }}">
                  <svg viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <p class="ai-contact-benefit-text-{{ ai_gen_id }}">{{ benefit_block }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.show_cta and block.settings.cta_text != blank %}
          <a href="{{ block.settings.cta_link }}" class="ai-contact-cta-{{ ai_gen_id }}">
            {{ block.settings.cta_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-contact-right-{{ ai_gen_id }}">
        <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
          {% form 'contact' %}
            <div class="ai-contact-form-{{ ai_gen_id }}">
              {% if form.posted_successfully? %}
                <div class="ai-contact-form-message-{{ ai_gen_id }} success">
                  {{ block.settings.success_message }}
                </div>
              {% endif %}

              {% if form.errors %}
                <div class="ai-contact-form-message-{{ ai_gen_id }} error">
                  {{ form.errors.messages | first }}
                </div>
              {% endif %}

              {% if block.settings.show_name_field %}
                <div class="ai-contact-form-field-{{ ai_gen_id }}">
                  <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-name-{{ ai_gen_id }}">
                    {{ block.settings.name_label }}
                  </label>
                  <input
                    type="text"
                    id="contact-name-{{ ai_gen_id }}"
                    name="contact[name]"
                    class="ai-contact-form-input-{{ ai_gen_id }}"
                    placeholder="{{ block.settings.name_placeholder }}"
                    {% if block.settings.name_required %}required{% endif %}
                  >
                </div>
              {% endif %}

              {% if block.settings.show_email_field %}
                <div class="ai-contact-form-field-{{ ai_gen_id }}">
                  <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
                    {{ block.settings.email_label }}
                  </label>
                  <input
                    type="email"
                    id="contact-email-{{ ai_gen_id }}"
                    name="contact[email]"
                    class="ai-contact-form-input-{{ ai_gen_id }}"
                    placeholder="{{ block.settings.email_placeholder }}"
                    autocomplete="email"
                    {% if block.settings.email_required %}required{% endif %}
                  >
                </div>
              {% endif %}

              {% if block.settings.show_phone_field %}
                <div class="ai-contact-form-field-{{ ai_gen_id }}">
                  <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-phone-{{ ai_gen_id }}">
                    {{ block.settings.phone_label }}
                  </label>
                  <input
                    type="tel"
                    id="contact-phone-{{ ai_gen_id }}"
                    name="contact[phone]"
                    class="ai-contact-form-input-{{ ai_gen_id }}"
                    placeholder="{{ block.settings.phone_placeholder }}"
                    autocomplete="tel"
                    {% if block.settings.phone_required %}required{% endif %}
                  >
                </div>
              {% endif %}

              {% if block.settings.show_service_field %}
                <div class="ai-contact-form-field-{{ ai_gen_id }}">
                  <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-service-{{ ai_gen_id }}">
                    {{ block.settings.service_label }}
                  </label>
                  <select
                    id="contact-service-{{ ai_gen_id }}"
                    name="contact[service]"
                    class="ai-contact-form-select-{{ ai_gen_id }}"
                    {% if block.settings.service_required %}required{% endif %}
                  >
                    <option value="">{{ block.settings.service_placeholder }}</option>
                    {% assign service_options = block.settings.service_options | split: ',' %}
                    {% for option in service_options %}
                      <option value="{{ option | strip }}">{{ option | strip }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endif %}

              {% if block.settings.show_message_field %}
                <div class="ai-contact-form-field-{{ ai_gen_id }}">
                  <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-message-{{ ai_gen_id }}">
                    {{ block.settings.message_label }}
                  </label>
                  <textarea
                    id="contact-message-{{ ai_gen_id }}"
                    name="contact[body]"
                    class="ai-contact-form-textarea-{{ ai_gen_id }}"
                    placeholder="{{ block.settings.message_placeholder }}"
                    {% if block.settings.message_required %}required{% endif %}
                  ></textarea>
                </div>
              {% endif %}

              <button type="submit" class="ai-contact-form-submit-{{ ai_gen_id }}">
                {{ block.settings.submit_button_text }}
              </button>
            </div>
          {% endform %}
        </div>

        {% if block.settings.show_stats %}
          <div class="ai-contact-stats-{{ ai_gen_id }}">
            {% for stat_block in block.settings.stats %}
              <div class="ai-contact-stat-{{ ai_gen_id }}">
                <div class="ai-contact-stat-icon-{{ ai_gen_id }}">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
                  </svg>
                </div>
                <p class="ai-contact-stat-value-{{ ai_gen_id }}">{{ stat_block.value }}</p>
                <p class="ai-contact-stat-label-{{ ai_gen_id }}">{{ stat_block.label }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</contact-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.setupFormValidation();
        }
      }

      setupFormValidation() {
        this.form.addEventListener('submit', (e) => {
          const requiredFields = this.form.querySelectorAll('[required]');
          let isValid = true;

          requiredFields.forEach(field => {
            if (!field.value.trim()) {
              isValid = false;
              field.style.borderColor = '#ef4444';
            } else {
              field.style.borderColor = '';
            }
          });

          if (!isValid) {
            e.preventDefault();
          }
        });

        const inputs = this.form.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
          input.addEventListener('input', () => {
            input.style.borderColor = '';
          });
        });
      }
    }

    customElements.define('contact-section-{{ ai_gen_id }}', ContactSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Contact consultation",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "label": "Horizontal padding mobile",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#000000"

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-case-studies-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    width: 100%;
  }

  .ai-case-studies-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-case-studies-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-case-studies-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .ai-case-studies-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-case-studies-filters-{{ ai_gen_id }} {
    margin-bottom: 48px;
  }

  .ai-case-studies-filter-group-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-case-studies-filter-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.filter_title_color }};
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-case-studies-filter-pills-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-case-studies-filter-pill-{{ ai_gen_id }} {
    padding: 10px 20px;
    background-color: {{ block.settings.pill_inactive_bg }};
    color: {{ block.settings.pill_inactive_text }};
    border: none;
    border-radius: {{ block.settings.pill_border_radius }}px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-case-studies-filter-pill-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pill_hover_bg }};
    transform: translateY(-1px);
  }

  .ai-case-studies-filter-pill-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.pill_active_bg }};
    color: {{ block.settings.pill_active_text }};
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.1);
  }

  .ai-case-studies-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .ai-case-studies-grid-{{ ai_gen_id }}.filtering {
    opacity: 0.5;
  }

  .ai-case-studies-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg }};
    border: 1px solid {{ block.settings.card_border }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .ai-case-studies-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: {{ block.settings.card_border_hover }};
  }

  .ai-case-studies-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    overflow: hidden;
    background-color: #0a0a0a;
  }

  .ai-case-studies-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-case-studies-card-{{ ai_gen_id }}:hover .ai-case-studies-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-case-studies-card-content-{{ ai_gen_id }} {
    padding: 28px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-case-studies-card-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_name_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_name_color }};
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .ai-case-studies-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-case-studies-card-tech-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-case-studies-tech-icon-{{ ai_gen_id }} {
    width: 28px;
    height: 28px;
    background-color: {{ block.settings.tech_icon_bg }};
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    color: {{ block.settings.tech_icon_text }};
    position: relative;
    transition: transform 0.2s ease;
  }

  .ai-case-studies-tech-icon-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-case-studies-tech-tooltip-{{ ai_gen_id }} {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .ai-case-studies-tech-icon-{{ ai_gen_id }}:hover .ai-case-studies-tech-tooltip-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-case-studies-card-tags-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .ai-case-studies-tag-{{ ai_gen_id }} {
    padding: 6px 12px;
    background-color: {{ block.settings.tag_bg }};
    color: {{ block.settings.tag_text }};
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }

  .ai-case-studies-card-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.cta_bg }};
    color: {{ block.settings.cta_text }};
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
    align-self: flex-start;
  }

  .ai-case-studies-card-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg }};
    color: {{ block.settings.cta_hover_text }};
    transform: translateX(4px);
  }

  .ai-case-studies-card-cta-arrow-{{ ai_gen_id }} {
    transition: transform 0.3s ease;
  }

  .ai-case-studies-card-cta-{{ ai_gen_id }}:hover .ai-case-studies-card-cta-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-case-studies-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 80px 20px;
    color: {{ block.settings.description_color }};
    font-size: 16px;
  }

  .ai-case-studies-card-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-case-studies-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .ai-case-studies-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-case-studies-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-case-studies-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-case-studies-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.5);
    }

    .ai-case-studies-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-case-studies-filter-pills-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-case-studies-filter-pill-{{ ai_gen_id }} {
      padding: 8px 16px;
      font-size: 13px;
    }

    .ai-case-studies-card-content-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<case-studies-{{ ai_gen_id }} class="ai-case-studies-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-case-studies-container-{{ ai_gen_id }}">
    <div class="ai-case-studies-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-case-studies-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-case-studies-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-case-studies-filters-{{ ai_gen_id }}">
      {% if block.settings.show_service_filters %}
        <div class="ai-case-studies-filter-group-{{ ai_gen_id }}">
          <div class="ai-case-studies-filter-title-{{ ai_gen_id }}">{{ block.settings.service_filter_title }}</div>
          <div class="ai-case-studies-filter-pills-{{ ai_gen_id }}" data-filter-type="service">
            <button class="ai-case-studies-filter-pill-{{ ai_gen_id }} active" data-filter="all">
              All
            </button>
            {% if block.settings.service_1 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_1 | handleize }}">
                {{ block.settings.service_1 }}
              </button>
            {% endif %}
            {% if block.settings.service_2 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_2 | handleize }}">
                {{ block.settings.service_2 }}
              </button>
            {% endif %}
            {% if block.settings.service_3 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_3 | handleize }}">
                {{ block.settings.service_3 }}
              </button>
            {% endif %}
            {% if block.settings.service_4 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_4 | handleize }}">
                {{ block.settings.service_4 }}
              </button>
            {% endif %}
            {% if block.settings.service_5 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_5 | handleize }}">
                {{ block.settings.service_5 }}
              </button>
            {% endif %}
            {% if block.settings.service_6 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.service_6 | handleize }}">
                {{ block.settings.service_6 }}
              </button>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_industry_filters %}
        <div class="ai-case-studies-filter-group-{{ ai_gen_id }}">
          <div class="ai-case-studies-filter-title-{{ ai_gen_id }}">{{ block.settings.industry_filter_title }}</div>
          <div class="ai-case-studies-filter-pills-{{ ai_gen_id }}" data-filter-type="industry">
            <button class="ai-case-studies-filter-pill-{{ ai_gen_id }} active" data-filter="all">
              All
            </button>
            {% if block.settings.industry_1 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_1 | handleize }}">
                {{ block.settings.industry_1 }}
              </button>
            {% endif %}
            {% if block.settings.industry_2 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_2 | handleize }}">
                {{ block.settings.industry_2 }}
              </button>
            {% endif %}
            {% if block.settings.industry_3 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_3 | handleize }}">
                {{ block.settings.industry_3 }}
              </button>
            {% endif %}
            {% if block.settings.industry_4 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_4 | handleize }}">
                {{ block.settings.industry_4 }}
              </button>
            {% endif %}
            {% if block.settings.industry_5 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_5 | handleize }}">
                {{ block.settings.industry_5 }}
              </button>
            {% endif %}
            {% if block.settings.industry_6 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_6 | handleize }}">
                {{ block.settings.industry_6 }}
              </button>
            {% endif %}
            {% if block.settings.industry_7 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_7 | handleize }}">
                {{ block.settings.industry_7 }}
              </button>
            {% endif %}
            {% if block.settings.industry_8 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_8 | handleize }}">
                {{ block.settings.industry_8 }}
              </button>
            {% endif %}
            {% if block.settings.industry_9 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_9 | handleize }}">
                {{ block.settings.industry_9 }}
              </button>
            {% endif %}
            {% if block.settings.industry_10 != blank %}
              <button class="ai-case-studies-filter-pill-{{ ai_gen_id }}" data-filter="{{ block.settings.industry_10 | handleize }}">
                {{ block.settings.industry_10 }}
              </button>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-case-studies-grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign project_name_key = 'project_' | append: i | append: '_name'
          assign project_description_key = 'project_' | append: i | append: '_description'
          assign project_image_key = 'project_' | append: i | append: '_image'
          assign project_url_key = 'project_' | append: i | append: '_url'
          assign project_services_key = 'project_' | append: i | append: '_services'
          assign project_industries_key = 'project_' | append: i | append: '_industries'
          assign project_tech_key = 'project_' | append: i | append: '_tech'
          assign project_tags_key = 'project_' | append: i | append: '_tags'
          assign project_cta_key = 'project_' | append: i | append: '_cta_text'

          assign project_name = block.settings[project_name_key]
          assign project_description = block.settings[project_description_key]
          assign project_image = block.settings[project_image_key]
          assign project_url = block.settings[project_url_key]
          assign project_services = block.settings[project_services_key]
          assign project_industries = block.settings[project_industries_key]
          assign project_tech = block.settings[project_tech_key]
          assign project_tags = block.settings[project_tags_key]
          assign project_cta = block.settings[project_cta_key]
        %}

        {% if project_name != blank %}
          <div 
            class="ai-case-studies-card-{{ ai_gen_id }}"
            data-services="{{ project_services | handleize }}"
            data-industries="{{ project_industries | handleize }}"
          >
            <div class="ai-case-studies-card-image-wrapper-{{ ai_gen_id }}">
              {% if project_image %}
                <img
                  src="{{ project_image | image_url: width: 800 }}"
                  alt="{{ project_name | escape }}"
                  class="ai-case-studies-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="450"
                >
              {% else %}
                <div class="ai-case-studies-card-image-{{ ai_gen_id }}" style="background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);"></div>
              {% endif %}
            </div>

            <div class="ai-case-studies-card-content-{{ ai_gen_id }}">
              <h3 class="ai-case-studies-card-name-{{ ai_gen_id }}">{{ project_name }}</h3>

              {% if project_description != blank %}
                <div class="ai-case-studies-card-description-{{ ai_gen_id }}">{{ project_description }}</div>
              {% endif %}

              {% if project_tech != blank %}
                <div class="ai-case-studies-card-tech-{{ ai_gen_id }}">
                  {% assign tech_items = project_tech | split: ',' %}
                  {% for tech in tech_items %}
                    {% assign tech_trimmed = tech | strip %}
                    {% assign tech_initial = tech_trimmed | slice: 0, 2 | upcase %}
                    <div class="ai-case-studies-tech-icon-{{ ai_gen_id }}">
                      {{ tech_initial }}
                      <div class="ai-case-studies-tech-tooltip-{{ ai_gen_id }}">{{ tech_trimmed }}</div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              {% if project_tags != blank %}
                <div class="ai-case-studies-card-tags-{{ ai_gen_id }}">
                  {% assign tag_items = project_tags | split: ',' %}
                  {% for tag in tag_items %}
                    <span class="ai-case-studies-tag-{{ ai_gen_id }}">{{ tag | strip }}</span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if project_url != blank %}
                <a href="{{ project_url }}" class="ai-case-studies-card-cta-{{ ai_gen_id }}">
                  {% if project_cta != blank %}
                    {{ project_cta }}
                  {% else %}
                    View Case Study
                  {% endif %}
                  <span class="ai-case-studies-card-cta-arrow-{{ ai_gen_id }}">→</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-case-studies-empty-{{ ai_gen_id }}" style="display: none;">
      No case studies match your selected filters.
    </div>
  </div>
</case-studies-{{ ai_gen_id }}>

<script>
  (function() {
    class CaseStudies{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.activeServiceFilter = 'all';
        this.activeIndustryFilter = 'all';
      }

      connectedCallback() {
        this.filterButtons = this.querySelectorAll('.ai-case-studies-filter-pill-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-case-studies-card-{{ ai_gen_id }}');
        this.grid = this.querySelector('.ai-case-studies-grid-{{ ai_gen_id }}');
        this.emptyState = this.querySelector('.ai-case-studies-empty-{{ ai_gen_id }}');
        
        this.setupFilters();
      }

      setupFilters() {
        this.filterButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const filterType = e.target.closest('[data-filter-type]').dataset.filterType;
            const filterValue = e.target.dataset.filter;
            
            const siblings = e.target.parentElement.querySelectorAll('.ai-case-studies-filter-pill-{{ ai_gen_id }}');
            siblings.forEach(btn => btn.classList.remove('active'));
            e.target.classList.add('active');
            
            if (filterType === 'service') {
              this.activeServiceFilter = filterValue;
            } else if (filterType === 'industry') {
              this.activeIndustryFilter = filterValue;
            }
            
            this.filterCards();
          });
        });
      }

      filterCards() {
        this.grid.classList.add('filtering');
        
        setTimeout(() => {
          let visibleCount = 0;
          
          this.cards.forEach(card => {
            const cardServices = card.dataset.services || '';
            const cardIndustries = card.dataset.industries || '';
            
            const serviceMatch = this.activeServiceFilter === 'all' || 
                                cardServices.includes(this.activeServiceFilter);
            const industryMatch = this.activeIndustryFilter === 'all' || 
                                  cardIndustries.includes(this.activeIndustryFilter);
            
            if (serviceMatch && industryMatch) {
              card.classList.remove('hidden');
              visibleCount++;
            } else {
              card.classList.add('hidden');
            }
          });
          
          if (visibleCount === 0) {
            this.emptyState.style.display = 'block';
            this.grid.style.display = 'none';
          } else {
            this.emptyState.style.display = 'none';
            this.grid.style.display = 'grid';
          }
          
          this.grid.classList.remove('filtering');
        }, 150);
      }
    }

    customElements.define('case-studies-{{ ai_gen_id }}', CaseStudies{{ ai_gen_id }});
  })();
</script>


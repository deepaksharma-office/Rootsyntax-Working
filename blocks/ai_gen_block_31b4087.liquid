{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-faq-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    padding: 30px 20px;
    box-sizing: border-box;
  }

  .ai-pricing-faq-{{ ai_gen_id }} *,
  .ai-pricing-faq-{{ ai_gen_id }} *::before,
  .ai-pricing-faq-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 32px;
    background: {{ block.settings.top_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 8px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__banner-copy {
    min-width: 0;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__top-title {
    margin: 0 0 7px;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 400;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__top-text {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-size: 14px;
    line-height: 1.55;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__button {
    flex: 0 0 auto;
    min-height: 60px;
    padding: 14px 26px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    border: 0;
    border-radius: 999px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 3px 8px rgba(35, 35, 35, .14);
    cursor: pointer;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__button--top {
    width: 280px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__button--bottom {
    min-width: 310px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__button:focus-visible,
  .ai-pricing-faq-{{ ai_gen_id }}__trigger:focus-visible {
    outline: 3px solid #000000;
    outline-offset: 3px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__cta .ai-pricing-faq-{{ ai_gen_id }}__button:focus-visible {
    outline-color: #ffffff;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__arrow {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__faq {
    margin-top: 68px;
    padding-top: 34px;
    border-top: 1px solid {{ block.settings.border_color }};
    display: grid;
    grid-template-columns: minmax(0, 40fr) minmax(0, 56fr);
    gap: 4%;
    color: #000000;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__intro {
    padding-top: 2px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1.3;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__faq-title {
    margin: 0;
    font-size: 46px;
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -.025em;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__intro-text {
    margin: 17px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__list {
    min-width: 0;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__item {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-pricing-faq-{{ ai_gen_id }}__trigger {
    width: 100%;
    min-height: 72px;
    padding: 21px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__question {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__icon::before,
  .ai-pricing-faq-{{ ai_gen_id }}__icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    content: '';
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .ai-pricing-faq-{{ ai_gen_id }}__icon::before {
    width: 14px;
    height: 1.5px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__icon::after {
    width: 1.5px;
    height: 14px;
    transition: opacity .25s ease;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__trigger[aria-expanded='true']
  .ai-pricing-faq-{{ ai_gen_id }}__icon::after {
    opacity: 0;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__panel {
    height: 0;
    overflow: hidden;
    transition: height .28s ease;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__answer {
    padding: 0 36px 21px 0;
    font-size: 14px;
    line-height: 1.65;
  }

  /* Keep all FAQ text and icons black, including theme overrides. */
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__eyebrow,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__faq-title,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__intro-text,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__trigger,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__question,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__icon,
  .ai-pricing-faq-{{ ai_gen_id }}__faq .ai-pricing-faq-{{ ai_gen_id }}__answer {
    color: #000000 !important;
    -webkit-text-fill-color: #000000 !important;
    opacity: 1;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__cta {
    margin-top: 60px;
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: {{ block.settings.footer_match_background }};
    color: #ffffff;
    border-radius: 8px;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__bottom-title {
    margin: 0 0 8px;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -.02em;
  }

  .ai-pricing-faq-{{ ai_gen_id }}__bottom-text {
    margin: 0;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    font-size: 16px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-pricing-faq-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__banner,
    .ai-pricing-faq-{{ ai_gen_id }}__cta {
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
      padding: 24px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__top-title {
      font-size: 22px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__button,
    .ai-pricing-faq-{{ ai_gen_id }}__button--top,
    .ai-pricing-faq-{{ ai_gen_id }}__button--bottom {
      width: 100%;
      min-width: 0;
      min-height: 56px;
      padding: 14px 18px;
      white-space: normal;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__faq {
      margin-top: 40px;
      padding-top: 28px;
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__eyebrow {
      margin-bottom: 14px;
    }

    .ai-pricing-faq- Diagnose{{ ai_gen_id }}__faq-title {
      font-size: 32px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__intro-text {
      margin-top: 12px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__trigger {
      min-height: 66px;
      padding: 19px 0;
      gap: 16px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__question {
      font-size: 15px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__cta {
      margin-top: 40px;
    }

    .ai-pricing-faq-{{ ai_gen_id }}__bottom-title {
      font-size: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-pricing-faq-{{ ai_gen_id }}__panel,
    .ai-pricing-faq-{{ ai_gen_id }}__icon::after {
      transition: none;
    }
  }
{% endstyle %}

<div
  class="ai-pricing-faq-{{ ai_gen_id }}"
  style="width: {{ block.settings.desktop_width_percent }}%;"
  {{ block.shopify_attributes }}
>
  <div class="ai-pricing-faq-{{ ai_gen_id }}__inner">
    <div class="ai-pricing-faq-{{ ai_gen_id }}__banner">
      <div class="ai-pricing-faq-{{ ai_gen_id }}__banner-copy">
        <h2 class="ai-pricing-faq-{{ ai_gen_id }}__top-title">
          {{ block.settings.top_heading | escape }}
        </h2>

        <p class="ai-pricing-faq-{{ ai_gen_id }}__top-text">
          {{ block.settings.top_text | escape }}
        </p>
      </div>

      <a
        class="ai-pricing-faq-{{ ai_gen_id }}__button ai-pricing-faq-{{ ai_gen_id }}__button--top"
        href="{{ block.settings.top_link | default: '/pages/contact' }}"
      >
        <span>{{ block.settings.top_button | escape }}</span>
        <svg
          class="ai-pricing-faq-{{ ai_gen_id }}__arrow"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <path
            d="M3 13 13 3M5 3h8v8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>

    <section
      class="ai-pricing-faq-{{ ai_gen_id }}__faq"
      aria-label="{{ block.settings.eyebrow | escape }}"
    >
      <div class="ai-pricing-faq-{{ ai_gen_id }}__intro">
        <p class="ai-pricing-faq-{{ ai_gen_id }}__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>

        <h2 class="ai-pricing-faq-{{ ai_gen_id }}__faq-title">
          {{ block.settings.faq_heading }}
        </h2>

        <p class="ai-pricing-faq-{{ ai_gen_id }}__intro-text">
          {{ block.settings.faq_subheading | escape }}
        </p>
      </div>

      <div class="ai-pricing-faq-{{ ai_gen_id }}__list" data-accordion>
        {% for i in (1..6) %}
          {% liquid
            assign question_key = 'question_' | append: i
            assign answer_key = 'answer_' | append: i
            assign question = block.settings[question_key]
            assign answer = block.settings[answer_key]
            assign panel_id = 'ai-faq-panel-' | append: ai_gen_id | append: '-' | append: i
          %}

          <div class="ai-pricing-faq-{{ ai_gen_id }}__item">
            <button
              class="ai-pricing-faq-{{ ai_gen_id }}__trigger"
              type="button"
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
            >
              <span class="ai-pricing-faq-{{ ai_gen_id }}__question">
                {{ question | escape }}
              </span>

              <span
                class="ai-pricing-faq-{{ ai_gen_id }}__icon"
                aria-hidden="true"
              ></span>
            </button>

            <div
              class="ai-pricing-faq-{{ ai_gen_id }}__panel"
              id="{{ panel_id }}"
              aria-hidden="true"
              inert
            >
              <div class="ai-pricing-faq-{{ ai_gen_id }}__answer">
                {{ answer | escape }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <div class="ai-pricing-faq-{{ ai_gen_id }}__cta">
      <div>
        <h2 class="ai-pricing-faq-{{ ai_gen_id }}__bottom-title">
          {{ block.settings.bottom_heading | escape }}
        </h2>

        <p class="ai-pricing-faq-{{ ai_gen_id }}__bottom-text">
          {{ block.settings.bottom_text | escape }}
        </p>
      </div>

      <a
        class="ai-pricing-faq-{{ ai_gen_id }}__button ai-pricing-faq-{{ ai_gen_id }}__button--bottom"
        href="{{ block.settings.bottom_link | default: '/pages/contact' }}"
      >
        <span>{{ block.settings.bottom_button | escape }}</span>

        <svg
          class="ai-pricing-faq-{{ ai_gen_id }}__arrow"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <path
            d="M3 13 13 3M5 3h8v8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  (() => {
    const element = document.querySelector('.ai-pricing-faq-{{ ai_gen_id }}');

    if (!element || element.dataset.accordionReady === 'true') return;

    element.dataset.accordionReady = 'true';

    const list = element.querySelector('[data-accordion]');
    const triggers = Array.from(
      list.querySelectorAll('.ai-pricing-faq-{{ ai_gen_id }}__trigger')
    );
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    const getPanel = (trigger) => {
      return element.querySelector(
        `#${CSS.escape(trigger.getAttribute('aria-controls'))}`
      );
    };

    const closeItem = (trigger) => {
      const panel = getPanel(trigger);

      if (!panel || trigger.getAttribute('aria-expanded') !== 'true') return;

      trigger.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      panel.inert = true;

      if (reducedMotion.matches) {
        panel.style.height = '0px';
        return;
      }

      panel.style.height = `${panel.scrollHeight}px`;

      requestAnimationFrame(() => {
        if (trigger.getAttribute('aria-expanded') === 'false') {
          panel.style.height = '0px';
        }
      });
    };

    const openItem = (trigger) => {
      const panel = getPanel(trigger);

      if (!panel) return;

      trigger.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      panel.inert = false;

      if (reducedMotion.matches) {
        panel.style.height = 'auto';
        return;
      }

      panel.style.height = `${panel.scrollHeight}px`;
    };

    triggers.forEach((trigger) => {
      const panel = getPanel(trigger);

      panel.addEventListener('transitionend', (event) => {
        if (
          event.target === panel &&
          event.propertyName === 'height' &&
          trigger.getAttribute('aria-expanded') === 'true'
        ) {
          panel.style.height = 'auto';
        }
      });

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        triggers.forEach((other) => {
          if (other !== trigger) closeItem(other);
        });

        if (isOpen) {
          closeItem(trigger);
        } else {
          openItem(trigger);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Project FAQ banners",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 900, "max": 1800, "step": 50, "unit": "px", "default": 1450 },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "work_sans_n4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292B2D" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#646A6D" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#D9DEDF" },
    { "type": "color", "id": "top_background", "label": "Top banner background", "default": "#F2F5F6" },
    { "type": "color", "id": "footer_match_background", "label": "Bottom banner background", "default": "#121E4E" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#FF7414" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },

    { "type": "header", "content": "Custom project banner" },
    { "type": "text", "id": "top_heading", "label": "Heading", "default": "A little outside the box?" },
    { "type": "textarea", "id": "top_text", "label": "Supporting text", "default": "Custom design, advanced integrations, B2B, and ongoing marketing or SEO can be scoped separately." },
    { "type": "text", "id": "top_button", "label": "Button label", "default": "Discuss your project" },
    { "type": "url", "id": "top_link", "label": "Button link" },

    { "type": "header", "content": "FAQ introduction" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GOOD QUESTIONS" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "A few things<br>to know." },
    { "type": "text", "id": "faq_subheading", "label": "Supporting text", "default": "Clarity before the first click." },

    { "type": "header", "content": "FAQ questions and answers" },

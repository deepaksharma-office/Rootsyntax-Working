    { "type": "text", "id": "question_2", "label": "Question 2", "default": "Are these one-time or monthly prices?" },
    { "type": "textarea", "id": "answer_2", "label": "Answer 2", "default": "These are one-time project prices. Shopify subscriptions, paid themes, apps, and ongoing services are separate." },

    { "type": "text", "id": "question_3", "label": "Question 3", "default": "How long will my store take to build?" },
    { "type": "textarea", "id": "answer_3", "label": "Answer 3", "default": "Estimated timelines are 1–2 weeks for Launch, 3–5 weeks for Growth, and 8–12 weeks for Scale. Your final schedule is confirmed after reviewing the scope and required content." },

    { "type": "text", "id": "question_4", "label": "Question 4", "default": "Can you migrate my existing store?" },
    { "type": "textarea", "id": "answer_4", "label": "Answer 4", "default": "Yes. Migration options depend on your platform, data, and selected package. We’ll confirm what is included before the project begins." },

    { "type": "text", "id": "question_5", "label": "Question 5", "default": "What happens after launch?" },
    { "type": "textarea", "id": "answer_5", "label": "Answer 5", "default": "We provide handover guidance and the support agreed in your proposal. Ongoing maintenance and marketing can be scoped separately." },

    { "type": "text", "id": "question_6", "label": "Question 6", "default": "Can I request features outside a package?" },
    { "type": "textarea", "id": "answer_6", "label": "Answer 6", "default": "Yes. Custom features, integrations, B2B requirements, and additional services can be quoted separately." },


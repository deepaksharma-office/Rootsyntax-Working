<script>
  (function() {
    class ConsultationForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const inputs = this.form.querySelectorAll('input[required], select[required]');
        let isValid = true;

        inputs.forEach(input => {
          if (!input.value.trim()) {
            isValid = false;
            input.style.borderColor = '#ef4444';
          } else {
            input.style.borderColor = '';
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('consultation-form-{{ ai_gen_id }}', ConsultationForm{{ ai_gen_id }});
  })();
</script>


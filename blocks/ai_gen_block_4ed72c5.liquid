{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rs-about-page-{{ section_id }} {
    background: #000000;
    width: 100%;
    display: block;
  }

  .rs-about-page-{{ section_id }} * {
    box-sizing: border-box;
  }

  .rs-about-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .rs-about-hero-{{ section_id }} {
    padding: 100px 20px;
  }

  .rs-about-hero__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .rs-about-hero__content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rs-eyebrow-{{ section_id }} {
    font-size: 12px;
    letter-spacing: 2px;
    color: #F97316;
    font-weight: 600;
    text-transform: uppercase;
  }

  .rs-about-hero__heading-{{ section_id }} {
    font-size: 56px;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
    font-weight: 700;
  }

  .rs-highlight-{{ section_id }} {
    background: linear-gradient(135deg, #F97316, #6C3CFF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rs-about-hero__desc-{{ section_id }} {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .rs-button-group-{{ section_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .rs-button-{{ section_id }} {
    padding: 14px 32px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .rs-button-primary-{{ section_id }} {
    background: #F97316;
    color: #ffffff;
  }

  .rs-button-primary-{{ section_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.3);
  }

  .rs-button-secondary-{{ section_id }} {
    background: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .rs-button-secondary-{{ section_id }}:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .rs-about-hero__visual-{{ section_id }} {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rs-abstract-visual-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.1), rgba(108, 60, 255, 0.1));
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .rs-glow-{{ section_id }} {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .rs-glow-orange-{{ section_id }} {
    width: 300px;
    height: 300px;
    background: #F97316;
    top: -100px;
    right: -100px;
  }

  .rs-glow-purple-{{ section_id }} {
    width: 250px;
    height: 250px;
    background: #6C3CFF;
    bottom: -80px;
    left: -80px;
  }

  .rs-glow-blue-{{ section_id }} {
    width: 200px;
    height: 200px;
    background: #0D5BFF;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-about-section-{{ section_id }} {
    padding: 80px 20px;
  }

  .rs-two-col-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .rs-section-heading-{{ section_id }} {
    font-size: 40px;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 20px;
    font-weight: 700;
  }

  .rs-section-text-{{ section_id }} {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .rs-highlight-box-{{ section_id }} {
    margin-top: 20px;
    padding: 20px;
    background: rgba(249, 115, 22, 0.1);
    border-left: 3px solid #F97316;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
  }

  .rs-stats-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .rs-stat-card-{{ section_id }} {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 40px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .rs-stat-card-{{ section_id }}:hover {
    transform: translateY(-4px);
    border-color: rgba(249, 115, 22, 0.5);
    box-shadow: 0 12px 40px rgba(249, 115, 22, 0.15);
  }

  .rs-stat-number-{{ section_id }} {
    font-size: 48px;
    font-weight: 700;
    background: linear-gradient(135deg, #F97316, #6C3CFF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 12px;
    line-height: 1;
  }

  .rs-stat-label-{{ section_id }} {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.4;
    margin: 0;
  }

  .rs-services-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .rs-service-card-{{ section_id }} {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 32px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .rs-service-card-{{ section_id }}:hover {
    transform: translateY(-4px);
    border-color: rgba(249, 115, 22, 0.5);
    box-shadow: 0 12px 40px rgba(249, 115, 22, 0.12);
  }

  .rs-service-icon-{{ section_id }} {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.2), rgba(108, 60, 255, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 16px;
  }

  .rs-service-title-{{ section_id }} {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .rs-service-desc-{{ section_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .rs-process-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .rs-process-card-{{ section_id }} {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }

  .rs-process-number-{{ section_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F97316, #6C3CFF);
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .rs-process-title-{{ section_id }} {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .rs-process-desc-{{ section_id }} {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .rs-values-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .rs-value-card-{{ section_id }} {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
  }

  .rs-value-icon-{{ section_id }} {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.2), rgba(108, 60, 255, 0.2));
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .rs-value-title-{{ section_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 8px;
  }

  .rs-value-desc-{{ section_id }} {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .rs-testimonials-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .rs-testimonial-card-{{ section_id }} {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 32px;
    position: relative;
  }

  .rs-quote-icon-{{ section_id }} {
    font-size: 48px;
    color: rgba(249, 115, 22, 0.3);
    line-height: 1;
    margin-bottom: 16px;
  }

  .rs-testimonial-text-{{ section_id }} {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 24px;
  }

  .rs-testimonial-author-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rs-author-avatar-{{ section_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F97316, #6C3CFF);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 600;
    font-size: 18px;
  }

  .rs-author-info-{{ section_id }} {
    flex: 1;
  }

  .rs-author-name-{{ section_id }} {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .rs-author-role-{{ section_id }} {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .rs-stars-{{ section_id }} {
    color: #F97316;
    font-size: 14px;
  }

  .rs-cta-section-{{ section_id }} {
    padding: 80px 20px 100px;
  }

  .rs-cta-card-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 60px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .rs-cta-heading-{{ section_id }} {
    font-size: 40px;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 16px;
    font-weight: 700;
  }

  .rs-cta-desc-{{ section_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .rs-section-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  @media screen and (max-width: 968px) {
    .rs-about-hero__grid-{{ section_id }},
    .rs-two-col-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .rs-stats-grid-{{ section_id }},
    .rs-process-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .rs-services-grid-{{ section_id }},
    .rs-testimonials-grid-{{ section_id }},
    .rs-values-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }

    .rs-about-hero__heading-{{ section_id }} {
      font-size: 36px;
    }

    .rs-section-heading-{{ section_id }},
    .rs-cta-heading-{{ section_id }} {
      font-size: 28px;
    }
  }

  @media screen and (max-width: 576px) {
    .rs-stats-grid-{{ section_id }},
    .rs-process-grid-{{ section_id }},
    .rs-values-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }

    .rs-button-group-{{ section_id }} {
      flex-direction: column;
    }

    .rs-button-{{ section_id }} {
      width: 100%;
    }

    .rs-about-hero-{{ section_id }},
    .rs-about-section-{{ section_id }} {
      padding: 60px 20px;

<script>
  (function() {
    class ContactSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initCharCounter();
      }

      initCharCounter() {
        const textarea = this.querySelector('[data-char-counter]');
        const counter = this.querySelector('[data-char-count]');
        
        if (textarea && counter) {
          textarea.addEventListener('input', function() {
            counter.textContent = this.value.length;
          });
        }
      }
    }

    customElements.define('contact-section-{{ ai_gen_id }}', ContactSection{{ ai_gen_id }});
  })();
</script>


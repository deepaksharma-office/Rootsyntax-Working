{% schema %}
{
  "name": "Shopify pricing cards",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOPIFY WEBSITE PACKAGES" },
    { "type": "text", "id": "heading_first", "label": "First line", "default": "Your next chapter." },
    { "type": "text", "id": "heading_second", "label": "Second line", "default": "Built on Shopify." },
    { "type": "header", "content": "Plan links" },
    { "type": "url", "id": "launch_link", "label": "Launch button link" },
    { "type": "url", "id": "growth_link", "label": "Growth button link" },
    { "type": "url", "id": "scale_link", "label": "Scale button link" }
  ],
  "presets": [{ "name": "Shopify pricing cards" }],
  "tag": null,
  "class": "shopify-pricing-block"
}
{% endschema %}

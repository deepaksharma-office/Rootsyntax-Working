{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 20px;
    background: #ffffff;
    color: #252923;
    font-family: var(--font-body-family, Arial, sans-serif);
  }

  .ai-pricing-{{ ai_gen_id }} *,
  .ai-pricing-{{ ai_gen_id }} *::before,
  .ai-pricing-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  .ai-pricing-{{ ai_gen_id }}__inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .ai-pricing-{{ ai_gen_id }}__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 20px;
    color: #173653;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ai-pricing-{{ ai_gen_id }}__dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: #3184c6;
  }

  .ai-pricing-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #252923;
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .ai-pricing-{{ ai_gen_id }}__heading em {
    display: block;
    color: #f36f19;
    font-weight: 400;
  }

  .ai-pricing-{{ ai_gen_id }}__rule {
    height: 1px;
    margin: 30px 0 20px;
    border: 0;
    background: #d9dddc;
  }

  .ai-pricing-{{ ai_gen_id }}__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 26px;
  }

  .ai-pricing-{{ ai_gen_id }}__pill {
    padding: 8px 13px;
    border-radius: 999px;
    background: #edf2f4;
    color: #35464f;
    font-size: 12px;
    line-height: 1.2;
  }

  .ai-pricing-{{ ai_gen_id }}__currency {
    margin: 0;
    color: #657078;
    font-size: 12px;
  }

  .ai-pricing-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 16px;
  }

  .ai-pricing-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 27px;
    border: 1px solid #dfe2df;
    border-radius: 8px;
    background: #f6f7f5;
    color: #252923;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured {
    border-color: #1f251e;
    background: #1f251e;
    color: #ffffff;
  }

  .ai-pricing-{{ ai_gen_id }}__card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-height: 19px;
    margin-bottom: 18px;
  }

  .ai-pricing-{{ ai_gen_id }}__number {
    margin: 0;
    color: #173653;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__number {
    color: #ff8a3d;
  }

  .ai-pricing-{{ ai_gen_id }}__badge {
    padding: 6px 9px;
    border-radius: 999px;
    background: #ff7414;
    color: #251b12;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .07em;
    white-space: nowrap;
  }

  .ai-pricing-{{ ai_gen_id }}__title {
    margin: 0 0 7px;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.15;
  }

  .ai-pricing-{{ ai_gen_id }}__description {
    min-height: 40px;
    margin: 0 0 20px;
    color: #59615d;
    font-size: 13px;
    line-height: 1.55;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__description {
    color: #c8cfca;
  }

  .ai-pr(change)-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 40px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.035em;
  }

  .ai-pricing-{{ ai_gen_id }}__price-note {
    margin: 6px 0 20px;
    color: #68716d;
    font-size: 11px;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__price-note {
    color: #c0c8c2;
  }

  .ai-pricing-{{ ai_gen_id }}__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 46px;
    padding: 12px 14px;
    border: 1px solid #414943;
    border-radius: 4px;
    background: #ffffff;
    color: #252923;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .ai-pricing-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid #3184c6;
    outline-offset: 3px;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__button {
    border-color: #ff7414;
    background: #ff7414;
    color: #21180f;
  }

  .ai-pricing-{{ ai_gen_id }}__arrow {
    font-size: 18px;
    line-height: 1;
  }

  .ai-pricing-{{ ai_gen_id }}__divider {
    width: 100%;
    height: 1px;
    margin: 22px 0 17px;
    border: 0;
    background: #d9dddc;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__divider {
    background: #454c45;
  }

  .ai-pricing-{{ ai_gen_id }}__feature-title {
    margin: 0 0 13px;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .08em;
    line-height: 1.4;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__title,
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__feature-title {
    color: #ffffff;
  }

  .ai-pricing-{{ ai_gen_id }}__features {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-pricing-{{ ai_gen_id }}__features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 11px;
    line-height: 1.45;
  }

  .ai-pricing-{{ ai_gen_id }}__check {
    flex: 0 0 13px;
    color: #23699a;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
  }

  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__check {
    color: #ff8a3d;
  }

  .ai-pricing-{{ ai_gen_id }}__delivery {
    margin: auto 0 0;
    padding-top: 23px;
    font-size: 11px;
    font-weight: 750;
    line-height: 1.45;
  }

  .ai-pricing-{{ ai_gen_id }}__note {
    max-width: 760px;
    margin: 20px auto 0;
    color: #69716e;
    font-size: 11px;
    line-height: 1.55;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-pricing-{{ ai_gen_id }} {
      width: 100%;
      padding: 44px 20px;
    }

    .ai-pricing-{{ ai_gen_id }}__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 20px;
    }

    .ai-pricing-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ai-pricing-{{ ai_gen_id }}__card {
      padding: 23px;
    }

    .ai-pricing-{{ ai_gen_id }}__description {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-pricing-{{ ai_gen_id }}__button {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

<div class="ai-pricing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-{{ ai_gen_id }}__inner">
    <p class="ai-pricing-{{ ai_gen_id }}__eyebrow">
      <span class="ai-pricing-{{ ai_gen_id }}__dot" aria-hidden="true"></span>
      {{ block.settings.eyebrow | escape }}
    </p>

    <h2 class="ai-pricing-{{ ai_gen_id }}__heading">
      {{ block.settings.heading_first | escape -}}
      <em>{{ block.settings.heading_second | escape }}</em>
    </h2>

    <hr class="ai-pricing-{{ ai_gen_id }}__rule">

    <div class="ai-pricing-{{ ai_gen_id }}__meta">
      <span class="ai-pricing-{{ ai_gen_id }}__pill">One-time project pricing</span>
      <p class="ai-pricing-{{ ai_gen_id }}__currency">
        All prices in USD · No monthly agency commitment
      </p>
    </div>

    <div class="ai-pricing-{{ ai_gen_id }}__grid">
      <article class="ai-pricing-{{ ai_gen_id }}__card">
        <div class="ai-pricing-{{ ai_gen_id }}__card-top">
          <p class="ai-pricing-{{ ai_gen_id }}__number">01 / START STRONG</p>
        </div>

        <h3 class="ai-pricing-{{ ai_gen_id }}__title">Launch</h3>
        <p class="ai-pricing-{{ ai_gen_id }}__description">
          A professional first store, without the complexity.
        </p>
        <p class="ai-pricing-{{ ai_gen_id }}__price">$1,000</p>
        <p class="ai-pricing-{{ ai_gen_id }}__price-note">USD · One-time investment</p>

        <a
          class="ai-pricing-{{ ai_gen_id }}__button"
          href="{{ block.settings.launch_link | default: '#' }}"
        >
          <span>Choose Launch</span>
          <span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span>
        </a>

        <hr class="ai-pricing-{{ ai_gen_id }}__divider">

        <h4 class="ai-pricing-{{ ai_gen_id }}__feature-title">YOUR LAUNCH ESSENTIALS</h4>

        <ul class="ai-pricing-{{ ai_gen_id }}__features">
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Premium theme customisation based on your brand guidelines</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Home, collection &amp; product pages + 15 pages customised</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Payments, shipping, taxes &amp; domain transfer</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>3 apps installed &amp; configured</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Mobile responsive customisation</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Recorded training walkthrough</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>2 revision rounds</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>7 days of free support after project completion</span>
          </li>
        </ul>

        <p class="ai-pricing-{{ ai_gen_id }}__delivery">Estimated delivery: 2 weeks</p>
      </article>

      <article class="ai-pricing-{{ ai_gen_id }}__card ai-pricing-{{ ai_gen_id }}__card--featured">
        <div class="ai-pricing-{{ ai_gen_id }}__card-top">
          <p class="ai-pricing-{{ ai_gen_id }}__number">02 / BUILD MOMENTUM</p>
          <span class="ai-pricing-{{ ai_gen_id }}__badge">THE GROWTH PICK</span>
        </div>

        <h3 class="ai-pricing-{{ ai_gen_id }}__title">Growth</h3>
        <p class="ai-pricing-{{ ai_gen_id }}__description">
          A tailored store for brands ready to go further.
        </p>
        <p class="ai-pricing-{{ ai_gen_id }}__price">$3,000</p>
        <p class="ai-pricing-{{ ai_gen_id }}__price-note">USD · One-time investment</p>

        <a
          class="ai-pricing-{{ ai_gen_id }}__button"
          href="{{ block.settings.growth_link | default: '#' }}"
        >
          <span>Choose Growth</span>
          <span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span>
        </a>

        <hr class="ai-pricing-{{ ai_gen_id }}__divider">

        <h4 class="ai-pricing-{{ ai_gen_id }}__feature-title">A MORE TAILORED FOUNDATION</h4>

        <ul class="ai-pricing-{{ ai_gen_id }}__features">
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Up to 100 products loaded &amp; 20 pages customised</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Marketing strategies</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Up to 5 apps installed &amp; configured</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Product migration, if required</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Mobile &amp; page speed optimisation</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Recorded training walkthrough</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>3 revision rounds</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>30 days of support</span>
          </li>
        </ul>

        <p class="ai-pricing-{{ ai_gen_id }}__delivery">Estimated delivery: 3–5 weeks</p>
      </article>

      <article class="ai-pricing-{{ ai_gen_id }}__card">
        <div class="ai-pricing-{{ ai_gen_id }}__card-top">
          <p class="ai-pricing-{{ ai_gen_id }}__number">03 / THINK BIGGER</p>
        </div>

        <h3 class="ai-pricing-{{ ai_gen_id }}__title">Scale</h3>
        <p class="ai-pricing-{{ ai_gen_id }}__description">
          A bespoke experience for your next stage of growth.
        </p>
        <p class="ai-pricing-{{ ai_gen_id }}__price">$10,000</p>
        <p class="ai-pricing-{{ ai_gen_id }}__price-note">USD · One-time investment</p>

        <a
          class="ai-pricing-{{ ai_gen_id }}__button"
          href="{{ block.settings.scale_link | default: '#' }}"
        >
          <span>Choose Scale</span>
          <span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span>
        </a>

        <hr class="ai-pricing-{{ ai_gen_id }}__divider">

        <h4 class="ai-pricing-{{ ai_gen_id }}__feature-title">A FULLY CUSTOM FOUNDATION</h4>

        <ul class="ai-pricing-{{ ai_gen_id }}__features">
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Unlimited custom wireframes</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Bulk product &amp; page import · 30+ pages customised</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Multichannel integration, marketing strategy &amp; advanced store setup</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>10+ apps installed with custom integrations</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>5 revision rounds</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>Dedicated project manager</span>
          </li>
          <li>
            <span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span>
            <span>60 days of support</span>
          </li>
        </ul>

        <p class="ai-pricing-{{ ai_gen_id }}__delivery">Estimated delivery: 8–12 weeks</p>
      </article>
    </div>

    <p class="ai-pricing-{{ ai_gen_id }}__note">
      Shopify subscriptions, paid themes, and third-party app charges should be confirmed separately before your project begins.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Shopify pricing cards",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOPIFY WEBSITE PACKAGES"
    },
    {
      "type": "text",
      "id": "heading_first",
      "label": "First line",
      "default": "Your next chapter."
    },
    {
      "type": "text",
      "id": "heading_second",
      "label": "Second line",
      "default": "Built on Shopify."
    },
    {
      "type": "header",
      "content": "Plan links"
    },
    {
      "type": "url",
      "id": "launch_link",
      "label": "Launch button link"
    },
    {
      "type": "url",
      "id": "growth_link",
      "label": "Growth button link"
    },
    {
      "type": "url",
      "id": "scale_link",
      "label": "Scale button link"
    }
  ],
  "presets": [
    {
      "name": "Shopify pricing cards"
    }
  ],
  "tag": null,
  "class": "shopify-pricing-block"
}
{% endschema %}
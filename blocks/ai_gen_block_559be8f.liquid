    {
      "type": "image_picker",
      "id": "floating_icon_2",
      "label": "Floating icon 2"
    },
    {
      "type": "image_picker",
      "id": "floating_icon_3",
      "label": "Floating icon 3"
    },
    {
      "type": "image_picker",
      "id": "floating_icon_4",
      "label": "Floating icon 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {

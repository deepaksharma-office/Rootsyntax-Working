{% doc %}
  @prompt
    Create a **“Platforms We Migrate From”** section in the existing RootSyntax website style, matching the provided reference design as closely as possible.
    
    Use **native Shopify Horizon sections** and keep everything editable in the Theme Editor. Do not create a completely custom page section.
    
    ### Design
    
    * Full-width dark/black background
    * Premium minimal RootSyntax aesthetic
    * Subtle purple glow on the left and orange glow on the right
    * Center-aligned content
    * Maximum content width around 1200px
    * Generous vertical spacing
    * White text with RootSyntax orange accent `#FF6A00`
    * Very subtle purple/orange borders
    * No unnecessary illustrations or large graphics
    
    ### Heading
    
    Small orange uppercase eyebrow:
    **WE MIGRATE FROM**
    
    Main heading:
    **Platforms We Migrate From**
    
    Make “Migrate From” orange and the rest white.
    
    Supporting text:
    **We make your migration to Shopify seamless, secure, and stress-free from the platforms you’re already using.**
    
    ### Migration Grid
    
    Create a single large rounded rectangular container below the heading.
    
    Use a **2-column × 6-row grid** with exactly these items:
    
    **Left column**
    
    1. Magento to Shopify
    2. Wix to Shopify
    3. Squarespace to Shopify
    4. Volusion to Shopify
    5. GoDaddy to Shopify
    6. Square to Shopify
    
    **Right column**
    
    1. Shopify to Shopify Plus
    2. BigCommerce to Shopify
    3. Webflow to Shopify
    4. Etsy to Shopify
    5. Custom Cart to Shopify
    6. eBay to Shopify
    
    ### Grid Styling
    
    * Background: near-black `#09090B`
    * Very subtle purple-to-orange gradient glow
    * Thin `1px` dark purple/gray border
    * Rounded corners: approximately 14px
    * Each row separated by extremely subtle horizontal dividers
    * Center vertical divider between the two columns
    * Each item has an orange `→` arrow inside a subtle circular outline
    * Arrow and circle should be purple/orange accented
    * Text is white/light gray
    * Font size around 17–18px desktop
    * Comfortable horizontal and vertical padding
    * No filled light-colored boxes
    
    ### Responsive
    
    Desktop: 2 columns × 6 rows.
    
    Tablet: 2 columns with reduced spacing.
    
    Mobile: 1 column, with all 12 migration options stacked vertically.
    
    ### Theme Editor Controls
    
    Make these editable:
    
    * Eyebrow text
    * Heading
    * Highlighted heading text
    * Description
    * Every migration item
    * Arrow/icon
    * Background color
    * Accent color
    * Border color
    * Border radius
    * Grid spacing
    * Section padding
    * Desktop/mobile column layout
    
    Use Horizon's native **Multicolumn / Rich Text / Grid-compatible section structure** wherever possible so the section remains easy to customize.
    
    The final result should visually match the reference: **minimal black background, centered heading, orange accent typography, and a large premium two-column migration list with subtle purple/orange glowing borders.**
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-migrate-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-migrate-section-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 100%;
    background: radial-gradient(ellipse at left, {{ block.settings.glow_color_left }}, transparent 70%);
    opacity: {{ block.settings.glow_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-migrate-section-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: radial-gradient(ellipse at right, {{ block.settings.glow_color_right }}, transparent 70%);
    opacity: {{ block.settings.glow_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-migrate-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-migrate-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-migrate-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-migrate-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-migrate-heading-{{ ai_gen_id }} .ai-migrate-highlight-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-migrate-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
    opacity: 0.9;
  }

  .ai-migrate-grid-wrapper-{{ ai_gen_id }} {
    background: {{ block.settings.grid_background }};
    border: {{ block.settings.grid_border_width }}px solid {{ block.settings.grid_border_color }};
    border-radius: {{ block.settings.grid_border_radius }}px;
    padding: {{ block.settings.grid_padding }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-migrate-grid-wrapper-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: {{ block.settings.grid_border_radius }}px;
    padding: 1px;
    background: linear-gradient(135deg, {{ block.settings.glow_color_left }}, transparent 40%, transparent 60%, {{ block.settings.glow_color_right }});
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: {{ block.settings.gradient_border_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-migrate-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: 0;
    position: relative;
  }

  .ai-migrate-grid-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: {{ block.settings.divider_color }};
    opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
  }

  .ai-migrate-item-{{ ai_gen_id }} {
    padding: {{ block.settings.item_padding }}px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
    transition: background 0.3s ease;
  }

  .ai-migrate-item-{{ ai_gen_id }}:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .ai-migrate-item-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .ai-migrate-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    border: 1px solid {{ block.settings.icon_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.02);
  }

  .ai-migrate-icon-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: {{ block.settings.accent_color }};
    stroke-width: 2;
  }

  .ai-migrate-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 400;
    opacity: 0.95;
  }

  @media screen and (max-width: 749px) {
    .ai-migrate-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-migrate-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-migrate-grid-{{ ai_gen_id }}::before {
      display: none;
    }

    .ai-migrate-item-{{ ai_gen_id }}:last-child {
      border-bottom: none;
    }

    .ai-migrate-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-migrate-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-migrate-grid-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.grid_padding | times: 0.7 }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-migrate-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}


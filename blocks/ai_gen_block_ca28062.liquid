{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-package-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.section_bg }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-package-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-package-{{ ai_gen_id }}__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .ai-package-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ai-package-{{ ai_gen_id }}__heading {
    margin: 0;
    font-size: {{ block.settings.heading_desktop }}px;
    line-height: 1.12;
    font-weight: 400;
    letter-spacing: -.025em;
  }

  .ai-package-{{ ai_gen_id }}__faq {
    color: #74797c;
    font-size: 14px;
    text-decoration: none;
    margin-bottom: 6px;
  }

  .ai-package-{{ ai_gen_id }}__faq:hover {
    text-decoration: underline;
  }

  .ai-package-{{ ai_gen_id }}__scroll {
    width: 100%;
    overflow-x: auto;
    margin-top: 30px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 6px;
    -webkit-overflow-scrolling: touch;
  }

  .ai-package-{{ ai_gen_id }}__table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    min-width: 800px;
    table-layout: fixed;
    font-size: {{ block.settings.table_text_size }}px;
  }

  .ai-package-{{ ai_gen_id }}__table th,
  .ai-package-{{ ai_gen_id }}__table td {
    padding: {{ block.settings.cell_padding }}px 16px;
    text-align: center;
    vertical-align: middle;
    border-bottom: 1px solid {{ block.settings.border_color }};
    font-weight: 400;
  }

  .ai-package-{{ ai_gen_id }}__table thead th {
    background: {{ block.settings.header_bg }};
    font-weight: 700;
  }

  .ai-package-{{ ai_gen_id }}__table tbody th {
    text-align: left;
    font-weight: 700;
  }

  .ai-package-{{ ai_gen_id }}__table tr:last-child th,
  .ai-package-{{ ai_gen_id }}__table tr:last-child td {
    border-bottom: 0;
  }

  .ai-package-{{ ai_gen_id }}__table th:first-child,
  .ai-package-{{ ai_gen_id }}__table td:first-child {
    width: 31%;
    text-align: left;
    position: sticky;
    left: 0;
    z-index: 2;
  }

  .ai-package-{{ ai_gen_id }}__table thead th:first-child {
    background: {{ block.settings.header_bg }};
    z-index: 4;
  }

  .ai-package-{{ ai_gen_id }}__table tbody th {
    background: {{ block.settings.section_bg }};
  }

  .ai-package-{{ ai_gen_id }}__table .ai-package-{{ ai_gen_id }}__highlight {
    background: {{ block.settings.highlight_bg }};
  }

  .ai-package-{{ ai_gen_id }}__table thead .ai-package-{{ ai_gen_id }}__highlight {
    background: {{ block.settings.highlight_bg }};
  }

  .ai-package-{{ ai_gen_id }}__footnote {
    margin: 16px 0 0;
    color: #74797c;
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .ai-package-{{ ai_gen_id }} {
      padding: 32px 20px;
    }

    .ai-package-{{ ai_gen_id }}__top {
      display: block;
    }

    .ai-package-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_mobile }}px;
    }

    .ai-package-{{ ai_gen_id }}__faq {
      display: inline-block;
      margin-top: 14px;
    }

    .ai-package-{{ ai_gen_id }}__table th:first-child,
    .ai-package-{{ ai_gen_id }}__table td:first-child {
      width: 220px;
    }
  }
{% endstyle %}

<section
  class="ai-package-{{ ai_gen_id }}"
  style="width:100%;"
  {{ block.shopify_attributes }}
>
  <div class="ai-package-{{ ai_gen_id }}__inner">
    <div class="ai-package-{{ ai_gen_id }}__top">
      <div>
        <p class="ai-package-{{ ai_gen_id }}__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>

        <h2 class="ai-package-{{ ai_gen_id }}__heading">
          {{ block.settings.heading | escape }}
        </h2>
      </div>

      {% if block.settings.faq_text != blank %}
        <a
          class="ai-package-{{ ai_gen_id }}__faq"
          href="{{ block.settings.faq_link }}"
        >
          {{ block.settings.faq_text | escape }}
        </a>
      {% endif %}
    </div>

    {% assign highlight = block.settings.highlight_column %}

    <div
      class="ai-package-{{ ai_gen_id }}__scroll"
      role="region"
      aria-label="Package comparison table"
      tabindex="0"
    >
      <table class="ai-package-{{ ai_gen_id }}__table">
        <thead>
          <tr>
            <th scope="col">
              {{ block.settings.first_title | escape }}
            </th>

            <th
              scope="col"
              {% if highlight == 'launch' %}
                class="ai-package-{{ ai_gen_id }}__highlight"
              {% endif %}
            >
              {{ block.settings.launch_title | escape }}
            </th>

            <th
              scope="col"
              {% if highlight == 'growth' %}
                class="ai-package-{{ ai_gen_id }}__highlight"
              {% endif %}
            >
              {{ block.settings.growth_title | escape }}
            </th>

            <th
              scope="col"
              {% if highlight == 'scale' %}
                class="ai-package-{{ ai_gen_id }}__highlight"
              {% endif %}
            >
              {{ block.settings.scale_title | escape }}
            </th>
          </tr>
        </thead>

        <tbody>
          {% for i in (1..15) %}
            {% assign feature_key = 'updated_feature_' | append: i %}
            {% assign launch_key = 'updated_launch_' | append: i %}
            {% assign growth_key = 'updated_growth_' | append: i %}
            {% assign scale_key = 'updated_scale_' | append: i %}

            <tr>
              <th scope="row">
                {{ block.settings[feature_key] | escape }}
              </th>

              <td
                {% if highlight == 'launch' %}
                  class="ai-package-{{ ai_gen_id }}__highlight"
                {% endif %}
              >
                {{ block.settings[launch_key] | escape }}
              </td>

              <td
                {% if highlight == 'growth' %}
                  class="ai-package-{{ ai_gen_id }}__highlight"
                {% endif %}
              >
                {{ block.settings[growth_key] | escape }}
              </td>

              <td
                {% if highlight == 'scale' %}
                  class="ai-package-{{ ai_gen_id }}__highlight"
                {% endif %}
              >
                {{ block.settings[scale_key] | escape }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <p class="ai-package-{{ ai_gen_id }}__footnote">
      {{ block.settings.updated_footnote | escape }}
    </p>
  </div>
</section>

{% schema %}

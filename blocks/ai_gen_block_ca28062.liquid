    {"type":"select","id":"highlight_column","label":"Highlighted column","options":[{"value":"launch","label":"Launch"},{"value":"growth","label":"Growth"},{"value":"scale","label":"Scale"}],"default":"growth"},
    {"type":"header","content":"Comparison rows"},
    {"type":"text","id":"feature_1","label":"Feature 1","default":"Project investment"},{"type":"text","id":"launch_1","label":"Launch 1","default":"$1,000"},{"type":"text","id":"growth_1","label":"Growth 1","default":"$3,000"},{"type":"text","id":"scale_1","label":"Scale 1","default":"$10,000"},
    {"type":"text","id":"feature_2","label":"Feature 2","default":"Design approach"},{"type":"text","id":"launch_2","label":"Launch 2","default":"Branded premium theme"},{"type":"text","id":"growth_2","label":"Growth 2","default":"Customized theme templates"},{"type":"text","id":"scale_2","label":"Scale 2","default":"Bespoke UI & sections"},
    {"type":"text","id":"feature_3","label":"Feature 3","default":"Products loaded"},{"type":"text","id":"launch_3","label":"Launch 3","default":"Up to 25"},{"type":"text","id":"growth_3","label":"Growth 3","default":"Up to 150 via CSV"},{"type":"text","id":"scale_3","label":"Scale 3","default":"Unlimited via bulk import"},
    {"type":"text","id":"feature_4","label":"Feature 4","default":"Pages"},{"type":"text","id":"launch_4","label":"Launch 4","default":"4 pages"},{"type":"text","id":"growth_4","label":"Growth 4","default":"Up to 8"},{"type":"text","id":"scale_4","label":"Scale 4","default":"20+ (scope confirmed)"},
    {"type":"text","id":"feature_5","label":"Feature 5","default":"App setup"},{"type":"text","id":"launch_5","label":"Launch 5","default":"1 app"},{"type":"text","id":"growth_5","label":"Growth 5","default":"Up to 3 apps"},{"type":"text","id":"scale_5","label":"Scale 5","default":"Up to 8 + integrations"},
    {"type":"text","id":"feature_6","label":"Feature 6","default":"Email marketing"},{"type":"text","id":"launch_6","label":"Launch 6","default":"Basic notifications"},{"type":"text","id":"growth_6","label":"Growth 6","default":"2 Klaviyo flows"},{"type":"text","id":"scale_6","label":"Scale 6","default":"Full Klaviyo flow suite"},
    {"type":"text","id":"feature_7","label":"Feature 7","default":"Migration"},{"type":"text","id":"launch_7","label":"Launch 7","default":"Available as add-on"},{"type":"text","id":"growth_7","label":"Growth 7","default":"Products & customers"},{"type":"text","id":"scale_7","label":"Scale 7","default":"Products, customers & orders"},
    {"type":"text","id":"feature_8","label":"Feature 8","default":"SEO"},{"type":"text","id":"launch_8","label":"Launch 8","default":"Titles & meta descriptions"},{"type":"text","id":"growth_8","label":"Growth 8","default":"On-page, redirects & sitemap"},{"type":"text","id":"scale_8","label":"Scale 8","default":"Technical audit, schema & mapping"},

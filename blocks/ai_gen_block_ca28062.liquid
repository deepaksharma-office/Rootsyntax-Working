    {"type":"range","id":"heading_mobile","label":"Mobile heading size","min":24,"max":40,"step":2,"unit":"px","default":32},
    {"type":"range","id":"table_text_size","label":"Table text size","min":12,"max":18,"step":1,"unit":"px","default":14},
    {"type":"range","id":"cell_padding","label":"Cell vertical padding","min":10,"max":26,"step":2,"unit":"px","default":18},
    {"type":"range","id":"section_padding","label":"Section vertical padding","min":24,"max":80,"step":4,"unit":"px","default":48},
    {"type":"color","id":"section_bg","label":"Section background","default":"#FFFFFF"},

{% enddoc %}
{% liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
%}

{% style %}
  .testimonial-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
    width: 100%;
    display: block;
  }

  .testimonial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .testimonial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.card_gap }}px;
  }

  .testimonial-card-{{ ai_gen_id }} {
    border-radius: {{ block.settings.card_radius }}px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    min-height: 600px;
  }

  .intro-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.intro_card_bg }};
    justify-content: space-between;
  }

  .testimonial-carousel-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.testimonial_card_bg }};
    position: relative;
    overflow: hidden;
  }

  .badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid {{ block.settings.body_color }};
    border-radius: 100px;
    margin-bottom: 24px;
    width: fit-content;
  }

  .badge-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.accent_color }};
  }

  .badge-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.body_color }};
  }

  .intro-heading-{{ ai_gen_id }} {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .intro-description-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.body_color }};
    margin-bottom: 40px;
  }

  .stats-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: auto;
  }

  .stat-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-value-{{ ai_gen_id }} {
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 700;
    color: {{ block.settings.accent_color }};
    line-height: 1;
  }

  .stat-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.muted_color }};
    line-height: 1.4;
  }

  .carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .testimonial-track-{{ ai_gen_id }} {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .testimonial-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    display: flex;
    flex-direction: column;
  }

  .testimonial-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .quote-mark-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 24px;
    width: 72px;
    height: 72px;
    opacity: 0.15;
    color: {{ block.settings.testimonial_text_color }};
    z-index: 1;
  }

  .author-row-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
    position: relative;
    z-index: 2;
  }

  .client-image-wrapper-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .client-image-wrapper-{{ ai_gen_id }}.is-logo {
    border-radius: 12px;
    padding: 8px;
  }

  .client-image-wrapper-{{ ai_gen_id }}.is-profile {
    border-radius: 50%;
    padding: 0;
  }

  .client-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
  }

  .client-image-{{ ai_gen_id }}.is-logo {
    object-fit: contain;
  }

  .client-image-{{ ai_gen_id }}.is-profile {
    object-fit: cover;
  }

  .client-fallback-{{ ai_gen_id }} {
    width: 28px;
    height: 28px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.5;
  }

  .client-info-wrapper-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .client-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .client-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.testimonial_text_color }};
    line-height: 1.3;
  }

  .client-role-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.7;
    line-height: 1.4;
  }

  .review-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.6;
    white-space: nowrap;
  }

  .ratings-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .rating-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rating-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.8;
    min-width: 130px;
  }

  .stars-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .star-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .star-{{ ai_gen_id }}.filled {
    color: #F5B942;
  }

  .star-{{ ai_gen_id }}.empty {
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.25;
  }

  .rating-value-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: #F5B942;
    margin-left: 4px;
  }

  .testimonial-text-{{ ai_gen_id }} {
    font-size: clamp(18px, 2.5vw, 22px);
    line-height: 1.6;
    color: {{ block.settings.testimonial_text_color }};
    margin-bottom: 24px;
  }

  .service-info-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.7;
    margin-bottom: 0;
  }

  .service-label-{{ ai_gen_id }} {
    font-weight: 600;
    opacity: 0.8;
  }

  .carousel-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: auto;
    padding-top: 32px;
  }

  .carousel-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.testimonial_text_color }};
  }

  .carousel-button-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .carousel-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .carousel-counter-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.testimonial_text_color }};
    opacity: 0.7;
    min-width: 60px;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .testimonial-container-{{ ai_gen_id }} {
      padding: 0 12px;
    }

    .testimonial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .testimonial-card-{{ ai_gen_id }} {
      padding: 32px 24px;
      min-height: auto;
    }

    .intro-card-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .testimonial-carousel-card-{{ ai_gen_id }} {
      min-height: 550px;
    }

    .stats-container-{{ ai_gen_id }} {
      gap: 24px;
    }

    .client-image-wrapper-{{ ai_gen_id }} {
      width: 54px;
      height: 54px;
    }

    .client-image-wrapper-{{ ai_gen_id }}.is-logo {
      padding: 6px;
    }

    .rating-label-{{ ai_gen_id }} {
      min-width: 110px;
      font-size: 13px;
    }

    .star-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .testimonial-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .quote-mark-{{ ai_gen_id }} {
      width: 56px;
      height: 56px;
      top: 16px;
      right: 16px;
    }

    .client-image-wrapper-{{ ai_gen_id }} {
      width: 50px;
      height: 50px;
    }

    .author-row-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .client-info-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .review-date-{{ ai_gen_id }} {
      align-self: flex-start;
    }

    .rating-label-{{ ai_gen_id }} {
      min-width: 100px;
      font-size: 12px;
    }

    .star-{{ ai_gen_id }} {
      width: 15px;
      height: 15px;
    }

    .ratings-container-{{ ai_gen_id }} {
      gap: 10px;
      margin-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-slide-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }}
  class="testimonial-section-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  data-show-counter="{{ block.settings.show_counter }}"
  data-show-images="{{ block.settings.show_client_images }}"
  {{ block.shopify_attributes }}
>
  <div class="testimonial-container-{{ ai_gen_id }}">
    <div class="testimonial-grid-{{ ai_gen_id }}">
      <div class="testimonial-card-{{ ai_gen_id }} intro-card-{{ ai_gen_id }}">
        <div>
          <div class="badge-{{ ai_gen_id }}">
            <svg class="badge-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <span class="badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
          </div>

          <h2 class="intro-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

          {% if block.settings.description != blank %}
            <div class="intro-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}
        </div>

        <div class="stats-container-{{ ai_gen_id }}">
          <div class="stat-{{ ai_gen_id }}">
            <div class="stat-value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</div>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
        this.isPaused = false;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.testimonial-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.carousel-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.carousel-next-{{ ai_gen_id }}');
        this.counter = this.querySelector('.current-slide-{{ ai_gen_id }}');
        this.track = this.querySelector('.testimonial-track-{{ ai_gen_id }}');
        this.card = this.querySelector('.testimonial-carousel-card-{{ ai_gen_id }}');

        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;
        this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (this.slides.length === 0) return;

        this.setupEventListeners();
        
        if (this.autoplayEnabled && !this.prefersReducedMotion) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          this.goToPrevSlide();
          this.resetAutoplay();
        });

        this.nextButton.addEventListener('click', () => {
          this.goToNextSlide();
          this.resetAutoplay();
        });

        this.card.addEventListener('mouseenter', () => {
          this.pauseAutoplay();
        });

        this.card.addEventListener('mouseleave', () => {
          this.resumeAutoplay();
        });

        this.prevButton.addEventListener('focus', () => {
          this.pauseAutoplay();
        });

        this.nextButton.addEventListener('focus', () => {
          this.pauseAutoplay();
        });

        this.prevButton.addEventListener('blur', () => {
          this.resumeAutoplay();
        });

        this.nextButton.addEventListener('blur', () => {
          this.resumeAutoplay();
        });

        this.track.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
          this.pauseAutoplay();
        }, { passive: true });

        this.track.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
          this.resumeAutoplay();
        }, { passive: true });
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.goToNextSlide();
          } else {
            this.goToPrevSlide();
          }
          this.resetAutoplay();
        }
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        this.currentSlide = index;
        this.slides[this.currentSlide].classList.add('active');
        
        if (this.counter) {
          this.counter.textContent = this.currentSlide + 1;
        }
      }

      goToNextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      goToPrevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        if (!this.autoplayEnabled || this.prefersReducedMotion) return;
        
        this.autoplayTimer = setInterval(() => {
          if (!this.isPaused) {
            this.goToNextSlide();
          }
        }, this.autoplaySpeed);
      }

      pauseAutoplay() {
        this.isPaused = true;
      }

      resumeAutoplay() {
        this.isPaused = false;
      }

      resetAutoplay() {
        if (!this.autoplayEnabled || this.prefersReducedMotion) return;
        
        clearInterval(this.autoplayTimer);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>


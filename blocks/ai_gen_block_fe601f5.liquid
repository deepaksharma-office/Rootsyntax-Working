{% doc %}
  @prompt
    Yes, I can see the issue. The **contact form card is wider than its parent container**, so it's overflowing and getting cut off on the right. This usually happens because Shopify AI generates the form with a fixed width or doesn't account for the page container width.
    
    Add the following instructions to your existing Shopify AI prompt (or replace the layout section with this version):
    
    ---
    
    ### **Updated Layout Instructions (Fix Overflow Issue)**
    
    > **Important:** The entire section must always fit inside the page container without any horizontal overflow.
    >
    > * Use a centered container with `max-width: 1320px` and `width: 100%`.
    > * Apply `padding-inline: clamp(20px, 4vw, 40px)` to the container.
    > * Use CSS Grid for the layout:
    >
    >   * `grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);`
    >   * Gap: `64px`.
    > * Both columns must have `min-width: 0` so they can shrink properly.
    > * The right contact form card must use:
    >
    >   * `width: 100%;`
    >   * `max-width: 100%;`
    >   * `box-sizing: border-box;`
    >   * Never use fixed widths like 700px or 800px.
    > * All input fields, textarea, and button must use `width: 100%` and never exceed the card width.
    > * The form card should align flush with the container edge and never extend outside the viewport.
    > * Ensure `overflow-x: hidden` on the section to prevent accidental horizontal scrolling.
    >
    > **Desktop**
    >
    > * Left column: approximately 44%.
    > * Right column: approximately 56%.
    > * The right form should fit comfortably within the container with visible spacing on both left and right sides.
    >
    > **Tablet**
    >
    > * Reduce the column gap to 40px.
    > * Keep both columns inside the container without clipping.
    >
    > **Mobile**
    >
    > * Switch to a single-column layout.
    > * Place the contact form below the content.
    > * All inputs should span the full card width.
    > * No horizontal scrolling.
    
    ---
    
    ### **Additional AI Instruction**
    
    > **Do not use viewport widths (100vw) or fixed pixel widths for the form card. Base all sizing on the parent container using percentages and `max-width: 100%`. The completed design must have equal left and right margins and no element should be clipped by the viewport.**
    
    This will prevent the right side from being cut off and keep the design visually identical to your mockup while remaining fully responsive in the Shopify Horizon theme.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow-x: hidden;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .ai-contact-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    gap: 64px;
    align-items: start;
  }

  .ai-contact-content-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-contact-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .ai-contact-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-contact-info-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-contact-info-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-info-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.info_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-contact-form-card-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    background-color: {{ block.settings.form_background }};
    border-radius: {{ block.settings.form_border_radius }}px;
    padding: {{ block.settings.form_padding }}px;
    box-sizing: border-box;
    box-shadow: {{ block.settings.form_shadow }};
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-form-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: 12px 16px;
    font-size: {{ block.settings.input_text_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border }};
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: 14px 24px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    box-sizing: border-box;
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-contact-form-message-{{ ai_gen_id }} {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 989px) {
    .ai-contact-grid-{{ ai_gen_id }} {
      gap: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-grid-{{ ai_gen_id }} {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .ai-contact-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .ai-contact-form-card-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <div class="ai-contact-grid-{{ ai_gen_id }}">
      <div class="ai-contact-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-contact-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        <div class="ai-contact-info-{{ ai_gen_id }}">
          {% if block.settings.show_email and block.settings.email != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m2 7 10 7 10-7"/>
                </svg>
              </div>
              <div class="ai-contact-info-text-{{ ai_gen_id }}">{{ block.settings.email }}</div>
            </div>
          {% endif %}

          {% if block.settings.show_phone and block.settings.phone != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="ai-contact-info-text-{{ ai_gen_id }}">{{ block.settings.phone }}</div>
            </div>
          {% endif %}

          {% if block.settings.show_address and block.settings.address != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div class="ai-contact-info-text-{{ ai_gen_id }}">{{ block.settings.address }}</div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-contact-form-card-{{ ai_gen_id }}">
        {% form 'contact' %}
          <div class="ai-contact-form-{{ ai_gen_id }}">
            {% if form.posted_successfully? %}
              <div class="ai-contact-form-message-{{ ai_gen_id }} ai-contact-form-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="ai-contact-form-message-{{ ai_gen_id }} ai-contact-form-error-{{ ai_gen_id }}">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="ai-contact-form-group-{{ ai_gen_id }}">
              <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                {{ block.settings.name_label }}
              </label>
              <input
                type="text"
                id="contact-name-{{ ai_gen_id }}"
                name="contact[name]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.name_placeholder }}"
                required
              >
            </div>

            <div class="ai-contact-form-group-{{ ai_gen_id }}">
              <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                {{ block.settings.email_label }}
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.email_placeholder }}"
                autocomplete="email"
                required
              >
            </div>

            {% if block.settings.show_phone_field %}
              <div class="ai-contact-form-group-{{ ai_gen_id }}">
                <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                  {{ block.settings.phone_label }}
                </label>
                <input
                  type="tel"
                  id="contact-phone-{{ ai_gen_id }}"
                  name="contact[phone]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  placeholder="{{ block.settings.phone_placeholder }}"
                  autocomplete="tel"
                >
              </div>
            {% endif %}

            <div class="ai-contact-form-group-{{ ai_gen_id }}">
              <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                {{ block.settings.message_label }}
              </label>
              <textarea
                id="contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-form-textarea-{{ ai_gen_id }}"
                placeholder="{{ block.settings.message_placeholder }}"
                required
              ></textarea>
            </div>

            <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form && form.querySelector('.ai-contact-form-success-{{ ai_gen_id }}')) {
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>


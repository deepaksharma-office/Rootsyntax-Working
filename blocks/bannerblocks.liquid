{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rootsyntax-video-hero-{{ section_id }} {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #000000;
  }

  .rootsyntax-video-hero-background-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .rootsyntax-video-hero-video-{{ section_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  .rootsyntax-video-hero-fallback-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rootsyntax-video-hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .rootsyntax-video-hero-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    max-width: 750px;
    width: 100%;
    padding-inline: 10px;
    text-align: center;
    color: {{ block.settings.text_color }};
  }

  .rootsyntax-video-hero-heading-{{ section_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(30px);
    animation: rootsyntax-video-hero-fade-up-{{ section_id }} 0.8s ease-out 0.2s forwards;
  }

  .rootsyntax-video-hero-heading-{{ section_id }} strong {
    color: {{ block.settings.accent_color }};
  }

  .rootsyntax-video-hero-description-{{ section_id }} {
    font-size: {{ block.settings.description_size_desktop }}px;
    font-weight: 400;
    line-height: 1.6;
    margin: 0 auto 36px;
    max-width: 650px;
    opacity: 0.9;
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(30px);
    animation: rootsyntax-video-hero-fade-up-{{ section_id }} 0.8s ease-out 0.4s forwards;
  }

  .rootsyntax-video-hero-buttons-{{ section_id }} {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(30px);
    animation: rootsyntax-video-hero-fade-up-{{ section_id }} 0.8s ease-out 0.6s forwards;
  }

  .rootsyntax-video-hero-button-primary-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text_color }};
    border-radius: 50px;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .rootsyntax-video-hero-button-primary-{{ section_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    background: linear-gradient(135deg, {{ block.settings.primary_button_bg }} 0%, {{ block.settings.accent_color }} 100%);
  }

  .rootsyntax-video-hero-button-secondary-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 40px;
    background: transparent;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50px;
    font-size: 16px;
    /* font-weight: 600; */
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .rootsyntax-video-hero-button-secondary-{{ section_id }}:hover {
    background: {{ block.settings.text_color }};
    color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 255, 255, 0.2);
  }

  .rootsyntax-video-hero-play-icon-{{ section_id }} {
    width: 18px;
    height: 18px;
  }

  .rootsyntax-video-hero-floating-icon-{{ section_id }} {
    position: absolute;
    z-index: 2;
    pointer-events: auto;
    transition: all 0.4s ease;
    will-change: transform;
  }

  .rootsyntax-video-hero-floating-icon-{{ section_id }} img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.3));
  }

  .rootsyntax-video-hero-floating-icon-{{ section_id }}:hover {
    transform: scale(1.1);
    filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.4));
  }

  .rootsyntax-video-hero-icon-1-{{ section_id }} {
    top: 10%;
    left: 8%;
    width: {{ block.settings.icon_size }}px;
    animation: rootsyntax-video-hero-float-1-{{ section_id }} 6s ease-in-out infinite;
  }

  .rootsyntax-video-hero-icon-2-{{ section_id }} {
    bottom: 15%;
    left: 12%;
    width: {{ block.settings.icon_size | times: 0.85 }}px;
    animation: rootsyntax-video-hero-float-2-{{ section_id }} 7s ease-in-out infinite;
  }

  .rootsyntax-video-hero-icon-3-{{ section_id }} {
    top: 15%;
    right: 10%;
    width: {{ block.settings.icon_size | times: 0.9 }}px;
    animation: rootsyntax-video-hero-float-3-{{ section_id }} 8s ease-in-out infinite;
  }

  .rootsyntax-video-hero-icon-4-{{ section_id }} {
    bottom: 12%;
    right: 8%;
    width: {{ block.settings.icon_size | times: 0.95 }}px;
    animation: rootsyntax-video-hero-float-4-{{ section_id }} 7.5s ease-in-out infinite;
  }

  @keyframes rootsyntax-video-hero-fade-up-{{ section_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  {% if block.settings.enable_floating_animation %}
    @keyframes rootsyntax-video-hero-float-1-{{ section_id }} {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-20px) rotate(5deg);
      }
    }

    @keyframes rootsyntax-video-hero-float-2-{{ section_id }} {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-25px) rotate(-5deg);
      }
    }

    @keyframes rootsyntax-video-hero-float-3-{{ section_id }} {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-18px) rotate(3deg);
      }
    }

    @keyframes rootsyntax-video-hero-float-4-{{ section_id }} {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-22px) rotate(-4deg);
      }
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .rootsyntax-video-hero-{{ section_id }} {
      min-height: {{ block.settings.hero_height_tablet }}px;
    }

    .rootsyntax-video-hero-heading-{{ section_id }} {
      font-size: {{ block.settings.heading_size_desktop | times: 0.75 }}px;
    }

    .rootsyntax-video-hero-description-{{ section_id }} {
      font-size: {{ block.settings.description_size_desktop | times: 0.9 }}px;
    }

    .rootsyntax-video-hero-icon-1-{{ section_id }},
    .rootsyntax-video-hero-icon-2-{{ section_id }},
    .rootsyntax-video-hero-icon-3-{{ section_id }},
    .rootsyntax-video-hero-icon-4-{{ section_id }} {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .rootsyntax-video-hero-{{ section_id }} {
      min-height: auto;
    }

    .rootsyntax-video-hero-content-{{ section_id }} {
      padding: 80px 20px;
    }

    .rootsyntax-video-hero-heading-{{ section_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin-bottom: 20px;
    }

    .rootsyntax-video-hero-description-{{ section_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
      margin-bottom: 28px;
    }

    .rootsyntax-video-hero-buttons-{{ section_id }} {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }

    .rootsyntax-video-hero-button-primary-{{ section_id }},
    .rootsyntax-video-hero-button-secondary-{{ section_id }} {
      width: 100%;
      max-width: 100%;
      padding: 14px 32px;
    }

    .rootsyntax-video-hero-icon-1-{{ section_id }},
    .rootsyntax-video-hero-icon-2-{{ section_id }},
    .rootsyntax-video-hero-icon-3-{{ section_id }},
    .rootsyntax-video-hero-icon-4-{{ section_id }} {
      width: 60px;
      opacity: 1;
    }

    .rootsyntax-video-hero-icon-1-{{ section_id }} {
      top: 5%;
      left: 2%;
    }

    .rootsyntax-video-hero-icon-2-{{ section_id }} {
      bottom: 3%;
      left: 3%;
    }

    .rootsyntax-video-hero-icon-3-{{ section_id }} {
      top: 5%;
      right: 2%;
    }

    .rootsyntax-video-hero-icon-4-{{ section_id }} {
      bottom: 3%;
      right: 3%;
    }
  }
{% endstyle %}

<premium-video-hero-{{ section_id }} class="rootsyntax-video-hero-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="rootsyntax-video-hero-background-{{ section_id }}">
    <div
      class="rootsyntax-video-hero-fallback-{{ section_id }}"
      style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
    >
      {% render 'banner-animation' %}
    </div>

    {% comment %} <div class="rootsyntax-video-hero-overlay-{{ section_id }}"></div> {% endcomment %}
  </div>

  {% if block.settings.floating_icon_1 %}
    <div class="rootsyntax-video-hero-floating-icon-{{ section_id }} rootsyntax-video-hero-icon-1-{{ section_id }}">
      <img
        src="{{ block.settings.floating_icon_1 | image_url: width: 200 }}"
        alt="{{ block.settings.floating_icon_1.alt | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% endif %}

  {% if block.settings.floating_icon_2 %}
    <div class="rootsyntax-video-hero-floating-icon-{{ section_id }} rootsyntax-video-hero-icon-2-{{ section_id }}">
      <img
        src="{{ block.settings.floating_icon_2 | image_url: width: 200 }}"
        alt="{{ block.settings.floating_icon_2.alt | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% endif %}

  {% if block.settings.floating_icon_3 %}
    <div class="rootsyntax-video-hero-floating-icon-{{ section_id }} rootsyntax-video-hero-icon-3-{{ section_id }}">
      <img
        src="{{ block.settings.floating_icon_3 | image_url: width: 200 }}"
        alt="{{ block.settings.floating_icon_3.alt | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% endif %}

  {% if block.settings.floating_icon_4 %}
    <div class="rootsyntax-video-hero-floating-icon-{{ section_id }} rootsyntax-video-hero-icon-4-{{ section_id }}">
      <img
        src="{{ block.settings.floating_icon_4 | image_url: width: 200 }}"
        alt="{{ block.settings.floating_icon_4.alt | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% endif %}

  <div class="rootsyntax-video-hero-content-{{ section_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="rootsyntax-video-hero-heading-{{ section_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="rootsyntax-video-hero-description-{{ section_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="rootsyntax-video-hero-buttons-{{ section_id }}">
      {% if block.settings.primary_button_label != blank %}
        <a
          href="{{ block.settings.primary_button_link }}"
          class="rootsyntax-video-hero-button-primary-{{ section_id }}"
        >
          {{ block.settings.primary_button_label }}
        </a>
      {% endif %}

      {% if block.settings.secondary_button_label != blank %}
        <a
          href="{{ block.settings.secondary_button_link }}"
          class="rootsyntax-video-hero-button-secondary-{{ section_id }}"
          target="_blank"
        >
          <svg
            class="rootsyntax-video-hero-play-icon-{{ section_id }}"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          {{ block.settings.secondary_button_label }}
        </a>
      {% endif %}
      <div class="rootsyntax-video-partner-badge-wrapper">
        <div class="rootsyntax-badge-flex">
        <div class="rootsyntax-video-partner-badge">

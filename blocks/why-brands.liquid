
{% assign block_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rootsyntax-growth-focused-{{ block_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top_desktop }}px 20px {{ block.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 989px) {
    .rootsyntax-growth-focused-{{ block_id }} {
      padding: {{ block.settings.padding_top_tablet }}px 20px {{ block.settings.padding_bottom_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .rootsyntax-growth-focused-{{ block_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }
  }

  .rootsyntax-growth-focused-container-{{ block_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .rootsyntax-growth-focused-header-{{ block_id }} {
    text-align: center;
    margin-bottom: 64px;
  }

  @media screen and (max-width: 749px) {
    .rootsyntax-growth-focused-header-{{ block_id }} {
      margin-bottom: 48px;
    }
  }

  .rootsyntax-growth-focused-label-{{ block_id }} {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
    margin-bottom: 16px;
  }

  .rootsyntax-growth-focused-heading-{{ block_id }} {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    color: {{ block.settings.primary_text_color }};
    margin: 0 0 20px;
  }

  @media screen and (max-width: 989px) {
    .rootsyntax-growth-focused-heading-{{ block_id }} {
      font-size: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .rootsyntax-growth-focused-heading-{{ block_id }} {
      font-size: 32px;
    }
  }

  .rootsyntax-growth-focused-description-{{ block_id }} {
    font-size: 16px;
    line-height: 1.8;
    color: {{ block.settings.secondary_text_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .rootsyntax-growth-focused-grid-{{ block_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  @media screen and (max-width: 989px) {
    .rootsyntax-growth-focused-grid-{{ block_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .rootsyntax-growth-focused-grid-{{ block_id }} {
      grid-template-columns: 1fr;
    }
  }

  .rootsyntax-growth-focused-card-{{ block_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
  }

  .rootsyntax-growth-focused-card-{{ block_id }}:hover {
    transform: translateY(-10px);
    border-color: {{ block.settings.accent_color }};
    box-shadow: 0 20px 40px rgba(79, 140, 255, 0.15);
  }

  .rootsyntax-growth-focused-card-{{ block_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at center, rgba(79, 140, 255, 0.05), transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .rootsyntax-growth-focused-card-{{ block_id }}:hover::before {
    opacity: 1;
  }

  .rootsyntax-growth-focused-icon-wrapper-{{ block_id }} {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: rgba(79, 140, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: all 0.3s ease;
    position: relative;
  }

  .rootsyntax-growth-focused-card-{{ block_id }}:hover .rootsyntax-growth-focused-icon-wrapper-{{ block_id }} {
    transform: scale(1.08);
    box-shadow: 0 0 30px rgba(79, 140, 255, 0.2);
  }

  .rootsyntax-growth-focused-icon-{{ block_id }} {
    width: 70px;
    height: 70px;
    transition: transform 0.3s ease;
  }

  .rootsyntax-growth-focused-icon-{{ block_id }} svg {
    width: 100%;
    height: 100%;
  }

  .rootsyntax-growth-focused-card-title-{{ block_id }} {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ block.settings.secondary_text_color }};
    margin: 0 0 16px;
    transition: color 0.3s ease;
  }

  .rootsyntax-growth-focused-card-{{ block_id }}:hover .rootsyntax-growth-focused-card-title-{{ block_id }} {
    color: {{ block.settings.primary_text_color }};
  }

  .rootsyntax-growth-focused-card-description-{{ block_id }} {
    font-size: 16px;
    line-height: 1.8;
    color: #B8B8B8;
    margin: 0 0 auto;
  }

  .rootsyntax-growth-focused-card-arrow-{{ block_id }} {
    margin-top: 20px;
    width: 24px;
    height: 24px;
    color: {{ block.settings.accent_color }};
    transition: transform 0.3s ease;
  }

  .rootsyntax-growth-focused-card-{{ block_id }}:hover .rootsyntax-growth-focused-card-arrow-{{ block_id }} {
    transform: translateY(-4px);
  }

  {% if block.settings.enable_animations %}
    @keyframes rootsyntax-growth-focused-fade-in-{{ block_id }} {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .rootsyntax-growth-focused-{{ block_id }}.rootsyntax-animated {
      animation: rootsyntax-growth-focused-fade-in-{{ block_id }} 0.5s ease forwards;
    }

    .rootsyntax-growth-focused-card-{{ block_id }} {
      opacity: 0;
      animation: rootsyntax-growth-focused-fade-in-{{ block_id }} 0.5s ease forwards;
    }

    {% for i in (1..12) %}
      .rootsyntax-growth-focused-card-{{ block_id }}:nth-child({{ i }}) {
        animation-delay: {{ i | times: 80 | divided_by: 1000.0 }}s;
      }
    {% endfor %}
  {% endif %}
{% endstyle %}




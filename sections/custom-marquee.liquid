<div
  id="swiper-marquee-{{ section.id }}"
  class="swiper-marquee"
  style="
    --marquee-bg: {{ section.settings.background_color }};
    --marquee-color: {{ section.settings.text_color }};
    --marquee-gap: {{ section.settings.gap }}px;
    --marquee-font-size-desktop: {{ section.settings.font_size_desktop }}px;
    --marquee-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --marquee-padding-top: {{ section.settings.padding_top }}px;
    --marquee-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width-normal">
    <div class="swiper swiper-marquee__slider">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div
            class="swiper-slide swiper-marquee__slide"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="swiper-marquee__item" target="_blank">
            {% else %}
              <div class="swiper-marquee__item">
            {% endif %}

            {% if block.settings.icon != blank %}
              <div class="swiper-marquee__icon">
                {{
                  block.settings.icon
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', widths: '30, 50, 70, 200'
                }}
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              <span class="swiper-marquee__text">
                {{ block.settings.text }}
              </span>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
        {% for block in section.blocks %}
          <div
            class="swiper-slide swiper-marquee__slide"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="swiper-marquee__item">
            {% else %}
              <div class="swiper-marquee__item">
            {% endif %}

            {% if block.settings.icon != blank %}
              <div class="swiper-marquee__icon">
                {{
                  block.settings.icon
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', widths: '30, 50, 70, 200'
                }}
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              <span class="swiper-marquee__text">
                {{ block.settings.text }}
              </span>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  #swiper-marquee-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background: var(--marquee-bg);
    color: var(--marquee-color);
    padding-top: var(--marquee-padding-top);
    padding-bottom: var(--marquee-padding-bottom);
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__slider {
    width: 100%;
    overflow: hidden;
  }

  #swiper-marquee-{{ section.id }} .swiper-wrapper {
    align-items: center;

    /* Important for smooth Swiper marquee */
    transition-timing-function: linear !important;
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__slide {
    width: auto !important;
    flex-shrink: 0;
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding-inline: var(--marquee-gap);

    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__text {
    font-size: var(--marquee-font-size-desktop);
    line-height: 1.2;
    font-weight: {{ section.settings.font_weight }};
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__icon {
    max-width: {{ section.settings.icon_size }}px;
    height:auto;
    flex-shrink: 0;
    border: 2px solid  #021227;
    border-radius:5px;
    padding:10px;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  }

  #swiper-marquee-{{ section.id }} .swiper-marquee__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    #swiper-marquee-{{ section.id }} .swiper-marquee__text {
      font-size: var(--marquee-font-size-mobile);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    initMarquee{{ section.id | replace: '-', '_' }}();
  });

  document.addEventListener('shopify:section:load', function (event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initMarquee{{ section.id | replace: '-', '_' }}();
    }
  });

  function initMarquee{{ section.id | replace: '-', '_' }}() {
    const section = document.querySelector(
      '#swiper-marquee-{{ section.id }}'
    );

    if (!section) return;

    const slider = section.querySelector('.swiper-marquee__slider');

    if (!slider) return;

    if (typeof Swiper === 'undefined') {
      console.warn('Swiper is not loaded.');
      return;
    }

    if (slider.swiper) {
      slider.swiper.destroy(true, true);
    }

    new Swiper(slider, {
      slidesPerView: 'auto',
      spaceBetween: 0,
      loop: true,
      allowTouchMove: {{ section.settings.allow_drag }},
      freeMode: true,

      speed: {{ section.settings.speed }},

      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: {{ section.settings.pause_on_hover }},
        reverseDirection: {% if section.settings.direction == 'right' %}true{% else %}false{% endif %}
      },

      observer: true,
      observeParents: true
    });
  }
</script>


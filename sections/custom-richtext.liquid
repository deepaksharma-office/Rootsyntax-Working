{{ 'custom-richtext.css' | asset_url | stylesheet_tag }}

<div id="custom-richtext-{{ section.id }}" class="custom-richtext" style="
  --richtext-background: {{ section.settings.background_color }};
  --richtext-text: {{ section.settings.text_color }};
  --richtext-gap: {{ section.settings.block_spacing }}px;
  --richtext-align: {{ section.settings.alignment }};
  --richtext-items-align: {% if section.settings.alignment == 'left' %}flex-start{% elsif section.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
  --richtext-width: {{ section.settings.content_width }}px;
  --richtext-padding-top: {{ section.settings.padding_top }}px;
  --richtext-padding-bottom: {{ section.settings.padding_bottom }}px;
  --richtext-padding-sides: {{ section.settings.padding_sides }}px;
">
  <div class="custom-richtext__inner">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'pill' %}
          {% if block.settings.text != blank %}
            <div class="custom-richtext__block" {{ block.shopify_attributes }}>
              <span class="custom-richtext__pill" style="
                background: {{ block.settings.background_color }};
                color: {{ block.settings.text_color }};
                border-color: {{ block.settings.border_color }};
                border-radius: {{ block.settings.radius }}px;
                font-size: {{ block.settings.font_size }}px;
              ">{{ block.settings.text | escape }}</span>
            </div>
          {% endif %}
        {% when 'title' %}
          {% if block.settings.text != blank %}
            <h2 class="custom-richtext__title custom-richtext__block" style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </h2>
          {% endif %}
        {% when 'richtext' %}
          {% if block.settings.content != blank %}
            <div class="custom-richtext__content custom-richtext__block" style="
              --richtext-highlight: {{ block.settings.highlight_color }};
              font-size: {{ block.settings.font_size }}px;
            " {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {% endif %}
        {% when 'button' %}
          {% if block.settings.label != blank %}
            <div class="custom-richtext__block" {{ block.shopify_attributes }}>
              <a class="custom-richtext__button" href="{{ block.settings.link | default: '#' }}"
                {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                style="
                  background: {{ block.settings.background_color }};
                  color: {{ block.settings.text_color }};
                  border-radius: {{ block.settings.radius }}px;
                  font-size: {{ block.settings.font_size }}px;
                ">
                {{ block.settings.label | escape }}
              </a>
            </div>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</div>



{% schema %}
{
  "name": "Custom rich text",
  "tag": "section",
  "class": "section-custom-richtext",
  "settings": [
    { "type": "select", "id": "alignment", "label": "Content alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 400, "max": 1400, "step": 20, "default": 800, "unit": "px" },
    { "type": "range", "id": "block_spacing", "label": "Space between blocks", "min": 0, "max": 80, "step": 2, "default": 20, "unit": "px" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_sides", "label": "Side padding", "min": 0, "max": 100, "step": 2, "default": 20, "unit": "px" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Default text color", "default": "#5d687a" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "About Us" },
        { "type": "range", "id": "font_size", "label": "Text size", "min": 10, "max": 30, "step": 1, "default": 12, "unit": "px" },
        { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#1e3978" },
        { "type": "color", "id": "border_color", "label": "Border color", "default": "#e5e8ee" },
        { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "default": 20, "unit": "px" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "settings": [
        { "type": "text", "id": "text", "label": "Title", "default": "Your title" },
        { "type": "range", "id": "font_size", "label": "Title size", "min": 16, "max": 100, "step": 2, "default": 40, "unit": "px" },
        { "type": "color", "id": "text_color", "label": "Title color", "default": "#1e3978" }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your text here. Select words and make them bold to highlight them.</p>" },
        { "type": "color", "id": "highlight_color", "label": "Bold text highlight color", "default": "#1e3978" },
        { "type": "range", "id": "font_size", "label": "Text size", "min": 12, "max": 60, "step": 1, "default": 24, "unit": "px" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false },
        { "type": "color", "id": "background_color", "label": "Background color", "default": "#1e3978" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 50, "step": 1, "default": 6, "unit": "px" },
        { "type": "range", "id": "font_size", "label": "Text size", "min": 12, "max": 30, "step": 1, "default": 16, "unit": "px" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom rich text",
      "blocks": [
        { "type": "pill" },
        { "type": "title" },
        { "type": "richtext" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}

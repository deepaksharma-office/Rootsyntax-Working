{{ 'custom-services.css' | asset_url | stylesheet_tag }}

{% liquid
  assign card_shadow = 'none'
  case section.settings.card_shadow
    when 'subtle'
      assign card_shadow = '0 3px 12px rgba(25, 35, 65, .04)'
    when 'medium'
      assign card_shadow = '0 9px 24px rgba(25, 35, 65, .1)'
  endcase
  assign hover_shadow = 'none'
  case section.settings.hover_shadow
    when 'subtle'
      assign hover_shadow = '0 7px 18px rgba(25, 35, 65, .09)'
    when 'medium'
      assign hover_shadow = '0 14px 30px rgba(25, 35, 65, .15)'
  endcase
%}

<section
  id="cust__services-{{ section.id }}"
  class="cust__services{% if section.settings.use_gradient %} cust__services--gradient{% endif %}{% if section.settings.enable_animation and section.settings.animation_style != 'none' %} cust__services--animated cust__services--{{ section.settings.animation_style }}{% endif %}"
  style="
    --cust-section-bg: {{ section.settings.background_color }};
    --cust-gradient-color: {{ section.settings.gradient_color }};
    --cust-gradient-direction: {{ section.settings.gradient_direction }};
    --cust-max-width: {{ section.settings.max_width }}px;
    --cust-desktop-columns: {{ section.settings.desktop_columns }};
    --cust-tablet-columns: {{ section.settings.tablet_columns }};
    --cust-mobile-columns: {{ section.settings.mobile_columns }};
    --cust-card-gap: {{ section.settings.card_gap }}px;
    --cust-row-gap: {{ section.settings.row_gap }}px;
    --cust-padding-top: {{ section.settings.padding_top }}px;
    --cust-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cust-padding-sides: {{ section.settings.padding_sides }}px;
    --cust-card-padding: {{ section.settings.card_padding }}px;
    --cust-card-bg: {{ section.settings.card_background }};
    --cust-card-border: {{ section.settings.card_border_color }};
    --cust-card-border-width: {{ section.settings.card_border_width }}px;
    --cust-card-radius: {{ section.settings.card_radius }}px;
    --cust-card-shadow: {{ card_shadow }};
    --cust-card-min-height: {{ section.settings.card_min_height }}px;
    --cust-hover-lift: {{ section.settings.hover_lift }}px;
    --cust-hover-border: {{ section.settings.hover_border_color }};
    --cust-hover-shadow: {{ hover_shadow }};
    --cust-title-color: {{ section.settings.title_color }};
    --cust-description-color: {{ section.settings.description_color }};
    --cust-title-size: {{ section.settings.title_size }}px;
    --cust-description-size: {{ section.settings.description_size }}px;
    --cust-title-weight: {{ section.settings.title_weight }};
    --cust-description-line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    --cust-image-width: {{ section.settings.image_width }}px;
    --cust-image-height: {{ section.settings.image_height }}px;
    --cust-image-fit: {{ section.settings.image_fit }};
    --cust-image-position: {{ section.settings.image_position }};
    --cust-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    --cust-image-top-spacing: {{ section.settings.image_top_spacing }}px;
    --cust-image-bottom-spacing: {{ section.settings.image_bottom_spacing }}px;
    --cust-animation-duration: {{ section.settings.animation_duration }}ms;
  "
>
  <div class="cust__services-inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <header class="cust__services-header cust__services-header--{{ section.settings.text_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="cust__services-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="cust__services-intro">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="cust__services-grid">
        {% for block in section.blocks %}
          {% liquid
            assign linked_card = false
            if block.settings.link != blank and block.settings.clickable_card
              assign linked_card = true
            endif
            assign image_alt = block.settings.image.alt | default: block.settings.title
            assign animation_delay = forloop.index0 | times: section.settings.animation_stagger
          %}
          {% if linked_card %}
            <a
              class="cust__service-card{% if block.settings.image == blank %} cust__service-card--text-only{% endif %}{% if section.settings.card_hover %} cust__service-card--hover{% endif %}"
              href="{{ block.settings.link }}"
              {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              style="
                --cust-block-bg: {% if block.settings.custom_card_background %}{{ block.settings.card_background }}{% else %}var(--cust-card-bg){% endif %};
                --cust-block-image-height: {% if block.settings.custom_image_height %}{{ block.settings.image_height }}px{% else %}var(--cust-image-height){% endif %};
                --cust-block-title-color: {{ block.settings.custom_title_color | default: section.settings.title_color }};
                --cust-block-description-color: {{ block.settings.custom_description_color | default: section.settings.description_color }};
                --cust-animation-delay: {{ animation_delay }}ms;
              "
              {{ block.shopify_attributes }}
            >
          {% else %}
            <article
              class="cust__service-card{% if block.settings.image == blank %} cust__service-card--text-only{% endif %}{% if section.settings.card_hover %} cust__service-card--hover{% endif %}"
              style="
                --cust-block-bg: {% if block.settings.custom_card_background %}{{ block.settings.card_background }}{% else %}var(--cust-card-bg){% endif %};
                --cust-block-image-height: {% if block.settings.custom_image_height %}{{ block.settings.image_height }}px{% else %}var(--cust-image-height){% endif %};
                --cust-block-title-color: {{ block.settings.custom_title_color | default: section.settings.title_color }};
                --cust-block-description-color: {{ block.settings.custom_description_color | default: section.settings.description_color }};
                --cust-animation-delay: {{ animation_delay }}ms;
              "
              {{ block.shopify_attributes }}
            >
          {% endif %}
            {% if block.settings.show_icon and block.settings.icon != blank %}
              <span class="cust__service-icon" style="--cust-icon-size: {{ block.settings.icon_size }}px; --cust-icon-bg: {{ block.settings.icon_background }};">
                {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', widths: '40, 80, 120', alt: '' }}
              </span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="cust__service-title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="cust__service-description">{{ block.settings.description | escape | newline_to_br }}</p>
            {% endif %}
            {% if block.settings.image != blank %}
              <div class="cust__service-media">
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag: class: 'cust__service-image', loading: 'lazy', widths: '180, 320, 480, 640, 800, 1000', sizes: '(min-width: 1100px) 33vw, (min-width: 750px) 50vw, 100vw', alt: image_alt
                }}
              </div>
            {% endif %}
          {% if linked_card %}</a>{% else %}</article>{% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom services",
  "tag": "section",
  "class": "section-custom-services",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "description", "label": "Section description" },
    { "type": "select", "id": "text_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "max_width", "label": "Maximum content width", "min": 600, "max": 1600, "step": 20, "default": 1200, "unit": "px" },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "tablet_columns", "label": "Tablet columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "range", "id": "card_gap", "label": "Column gap", "min": 0, "max": 60, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "row_gap", "label": "Row gap", "min": 0, "max": 60, "step": 2, "default": 16, "unit": "px" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_sides", "label": "Side padding", "min": 0, "max": 80, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 8, "max": 48, "step": 2, "default": 20, "unit": "px" },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "checkbox", "id": "use_gradient", "label": "Use background gradient", "default": false },
    { "type": "color", "id": "gradient_color", "label": "Gradient color", "default": "#f6f7fb" },
    { "type": "select", "id": "gradient_direction", "label": "Gradient direction", "options": [{ "value": "to right", "label": "Left to right" }, { "value": "to left", "label": "Right to left" }, { "value": "to bottom", "label": "Top to bottom" }, { "value": "to top", "label": "Bottom to top" }], "default": "to bottom" },
    { "type": "header", "content": "Card appearance" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f8f9fb" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#e7eaf0" },
    { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 36, "step": 1, "default": 16, "unit": "px" },
    { "type": "select", "id": "card_shadow", "label": "Card shadow", "options": [{ "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "medium", "label": "Medium" }], "default": "subtle" },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 180, "max": 500, "step": 10, "default": 320, "unit": "px" },
    { "type": "checkbox", "id": "card_hover", "label": "Enable hover effect", "default": true },
    { "type": "range", "id": "hover_lift", "label": "Hover lift", "min": 0, "max": 16, "step": 1, "default": 3, "unit": "px" },
    { "type": "color", "id": "hover_border_color", "label": "Hover border color", "default": "#cfd8ec" },
    { "type": "select", "id": "hover_shadow", "label": "Hover shadow", "options": [{ "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "medium", "label": "Medium" }], "default": "subtle" },
    { "type": "header", "content": "Typography" },
    { "type": "color", "id": "title_color", "label": "Card title color", "default": "#253040" },
    { "type": "color", "id": "description_color", "label": "Card description color", "default": "#6d7788" },
    { "type": "range", "id": "title_size", "label": "Card title size", "min": 12, "max": 32, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "description_size", "label": "Card description size", "min": 10, "max": 24, "step": 1, "default": 13, "unit": "px" },
    { "type": "select", "id": "title_weight", "label": "Card title weight", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi bold" }, { "value": "700", "label": "Bold" }], "default": "600" },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 100, "max": 200, "step": 5, "default": 145, "unit": "%" },
    { "type": "header", "content": "Images" },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 100, "max": 800, "step": 10, "default": 320, "unit": "px" },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 80, "max": 400, "step": 10, "default": 190, "unit": "px" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }], "default": "contain" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },
    { "type": "range", "id": "image_opacity", "label": "Image opacity", "min": 10, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "range", "id": "image_top_spacing", "label": "Space above image", "min": 0, "max": 80, "step": 2, "default": 18, "unit": "px" },
    { "type": "range", "id": "image_bottom_spacing", "label": "Space below image", "min": 0, "max": 60, "step": 2, "default": 0, "unit": "px" },
    { "type": "header", "content": "Entrance animation" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable entrance animation", "default": false },
    { "type": "select", "id": "animation_style", "label": "Animation style", "options": [{ "value": "none", "label": "None" }, { "value": "fade", "label": "Fade" }, { "value": "fade_up", "label": "Fade up" }, { "value": "scale", "label": "Scale" }], "default": "fade_up" },
    { "type": "range", "id": "animation_duration", "label": "Animation duration", "min": 200, "max": 1200, "step": 50, "default": 500, "unit": "ms" },
    { "type": "range", "id": "animation_stagger", "label": "Delay between cards", "min": 0, "max": 400, "step": 25, "default": 75, "unit": "ms" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Service title", "default": "Service title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Describe this service." },
        { "type": "image_picker", "id": "image", "label": "Service image" },
        { "type": "url", "id": "link", "label": "Service link" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open link in new tab", "default": false },
        { "type": "checkbox", "id": "clickable_card", "label": "Make entire card clickable", "default": true },
        { "type": "header", "content": "Optional icon" },
        { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": false },
        { "type": "image_picker", "id": "icon", "label": "Icon image" },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 20, "max": 100, "step": 2, "default": 40, "unit": "px" },
        { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#ffffff" },
        { "type": "header", "content": "Card overrides" },
        { "type": "checkbox", "id": "custom_card_background", "label": "Use custom card background", "default": false },
        { "type": "color", "id": "card_background", "label": "Custom card background", "default": "#f8f9fb" },
        { "type": "checkbox", "id": "custom_image_height", "label": "Use custom image height", "default": false },
        { "type": "range", "id": "image_height", "label": "Custom image height", "min": 80, "max": 400, "step": 10, "default": 190, "unit": "px" },
        { "type": "color", "id": "custom_title_color", "label": "Custom title color" },
        { "type": "color", "id": "custom_description_color", "label": "Custom description color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom services",
      "blocks": [
        { "type": "service", "settings": { "title": "Store Build Or Redesign", "description": "Launch a conversion-focused Shopify store optimized for performance and growth." } },
        { "type": "service", "settings": { "title": "Migration To Shopify", "description": "Custom Shopify development tailored to your business goals." } },
        { "type": "service", "settings": { "title": "Expert Guidance and Store Setup", "description": "Move seamlessly from WooCommerce, Magento, Wix, or custom platforms." } },
        { "type": "service", "settings": { "title": "Digital Marketing and SEO", "description": "Connect powerful apps and automations that improve efficiency." } },
        { "type": "service", "settings": { "title": "Wholesale/B2B Solutions", "description": "Increase conversions through UX improvements and data-driven testing." } },
        { "type": "service", "settings": { "title": "Conversion Rate Optimization", "description": "Ongoing technical support and store improvements." } }
      ]
    }
  ]
}
{% endschema %}

{{ 'custom-success-cta.css' | asset_url | stylesheet_tag }}

<section id="cust__cta-{{ section.id }}" class="cust__cta" style="
  --cust-section-bg: {{ section.settings.section_background }}; --cust-width: {{ section.settings.max_width }}px; --cust-align: {{ section.settings.horizontal_alignment }}; --cust-gap: {{ section.settings.content_gap }}px; --cust-top: {{ section.settings.padding_top }}px; --cust-bottom: {{ section.settings.padding_bottom }}px; --cust-mobile-padding: {{ section.settings.mobile_padding }}px;
  --cust-bg: {{ section.settings.container_background }}; --cust-border: {{ section.settings.border_color }}; --cust-border-width: {{ section.settings.border_width }}px; --cust-radius: {{ section.settings.border_radius }}px; --cust-container-padding: {{ section.settings.container_padding }}px;
  --cust-icon-size: {{ section.settings.icon_size }}px; --cust-icon-bg: {{ section.settings.icon_background }}; --cust-icon-color: {{ section.settings.icon_color }}; --cust-icon-border: {{ section.settings.icon_border }}; --cust-icon-radius: {{ section.settings.icon_radius }}px;
  --cust-heading-color: {{ section.settings.heading_color }}; --cust-heading-size: {{ section.settings.heading_size }}px; --cust-heading-weight: {{ section.settings.heading_weight }}; --cust-heading-line: {{ section.settings.heading_line_height | divided_by: 100.0 }};
  --cust-description-color: {{ section.settings.description_color }}; --cust-description-size: {{ section.settings.description_size }}px; --cust-description-line: {{ section.settings.description_line_height | divided_by: 100.0 }};
  --cust-secondary-bg: {{ section.settings.secondary_background }}; --cust-secondary-color: {{ section.settings.secondary_color }}; --cust-secondary-border: {{ section.settings.secondary_border }}; --cust-secondary-border-width: {{ section.settings.secondary_border_width }}px; --cust-secondary-radius: {{ section.settings.secondary_radius }}px; --cust-secondary-size: {{ section.settings.secondary_size }}px; --cust-secondary-weight: {{ section.settings.secondary_weight }}; --cust-secondary-padding: {{ section.settings.secondary_padding }}px; --cust-secondary-hover-bg: {{ section.settings.secondary_hover_background }}; --cust-secondary-hover-color: {{ section.settings.secondary_hover_color }};
  --cust-primary-bg: {{ section.settings.primary_background }}; --cust-primary-color: {{ section.settings.primary_color }}; --cust-primary-hover-bg: {{ section.settings.primary_hover_background }}; --cust-primary-hover-color: {{ section.settings.primary_hover_color }}; --cust-primary-radius: {{ section.settings.primary_radius }}px; --cust-primary-size: {{ section.settings.primary_size }}px; --cust-primary-weight: {{ section.settings.primary_weight }}; --cust-primary-padding: {{ section.settings.primary_padding }}px;
"{% if section.settings.container_shadow %} data-shadow{% endif %}{% if section.settings.enable_hover %} data-hover{% endif %}{% if section.settings.primary_shadow %} data-primary-shadow{% endif %}{% if section.settings.primary_hover_shadow %} data-primary-hover-shadow{% endif %}>
  <div class="cust__cta-container">
    {% if section.settings.show_icon %}
      <div class="cust__cta-icon" aria-hidden="true">
        {% case section.settings.icon_type %}
          {% when 'image' %}{% if section.settings.icon_image != blank %}{{ section.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>✦</span>{% endif %}
          {% when 'emoji' %}<span>{{ section.settings.icon_emoji | escape }}</span>
          {% when 'text' %}<span>{{ section.settings.icon_text | escape }}</span>
          {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M2 3h2l2.4 11.2a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6L21.5 7H5"/></svg>
        {% endcase %}
      </div>
    {% endif %}
    <div class="cust__cta-content">
      {% if section.settings.heading != blank %}<h2 class="cust__cta-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.description != blank %}<p class="cust__cta-description">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    {% if section.settings.show_secondary or section.settings.show_primary %}
      <div class="cust__cta-actions">
        {% if section.settings.show_secondary %}
          {% if section.settings.secondary_link != blank %}<a class="cust__cta-button cust__cta-button--secondary" href="{{ section.settings.secondary_link }}"{% if section.settings.secondary_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ section.settings.secondary_text | escape }}</a>
          {% else %}<span class="cust__cta-button cust__cta-button--secondary cust__cta-button--inactive">{{ section.settings.secondary_text | escape }}</span>{% endif %}
        {% endif %}
        {% if section.settings.show_primary %}
          {% if section.settings.primary_link != blank %}<a class="cust__cta-button cust__cta-button--primary" href="{{ section.settings.primary_link }}"{% if section.settings.primary_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ section.settings.primary_text | escape }}{% if section.settings.show_arrow %}<span aria-hidden="true">→</span>{% endif %}</a>
          {% else %}<span class="cust__cta-button cust__cta-button--primary cust__cta-button--inactive">{{ section.settings.primary_text | escape }}{% if section.settings.show_arrow %}<span aria-hidden="true">→</span>{% endif %}</span>{% endif %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom success CTA",
  "tag": "section",
  "class": "section-custom-success-cta",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Build the Next Success Story?" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "From ambitious established brands to growing Shopify merchants, we drive measurable growth and long-term success." },
    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 700, "max": 1600, "step": 20, "default": 1200, "unit": "px" },
    { "type": "select", "id": "horizontal_alignment", "label": "Horizontal alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "content_gap", "label": "Content gap", "min": 8, "max": 64, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "mobile_padding", "label": "Mobile side padding", "min": 12, "max": 40, "step": 2, "default": 16, "unit": "px" },
    { "type": "header", "content": "Container" },
    { "type": "color", "id": "container_background", "label": "Background", "default": "#fafbfe" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#dde4ef" },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 40, "step": 1, "default": 18, "unit": "px" },
    { "type": "checkbox", "id": "container_shadow", "label": "Show shadow", "default": false },
    { "type": "range", "id": "container_padding", "label": "Inner padding", "min": 12, "max": 64, "step": 2, "default": 28, "unit": "px" },
    { "type": "checkbox", "id": "enable_hover", "label": "Enable hover effect", "default": true },
    { "type": "header", "content": "Icon" },
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
    { "type": "select", "id": "icon_type", "label": "Icon type", "options": [{ "value": "svg", "label": "Cart icon" }, { "value": "image", "label": "Image" }, { "value": "emoji", "label": "Emoji" }, { "value": "text", "label": "Text" }], "default": "svg" },
    { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
    { "type": "text", "id": "icon_emoji", "label": "Emoji", "default": "✨" },
    { "type": "text", "id": "icon_text", "label": "Icon text", "default": "✦" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 28, "max": 96, "step": 2, "default": 48, "unit": "px" },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#ffffff" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#273451" },
    { "type": "color", "id": "icon_border", "label": "Icon border", "default": "#e1e7ef" },
    { "type": "range", "id": "icon_radius", "label": "Icon radius", "min": 0, "max": 50, "step": 1, "default": 50, "unit": "px" },
    { "type": "header", "content": "Typography" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#273247" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 40, "step": 1, "default": 22, "unit": "px" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }], "default": "700" },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 100, "max": 180, "step": 5, "default": 125, "unit": "%" },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#687489" },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 11, "max": 20, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 110, "max": 200, "step": 5, "default": 150, "unit": "%" },
    { "type": "header", "content": "Secondary button" },
    { "type": "checkbox", "id": "show_secondary", "label": "Show secondary button", "default": true },
    { "type": "text", "id": "secondary_text", "label": "Text", "default": "View All Projects" },
    { "type": "url", "id": "secondary_link", "label": "Link" },
    { "type": "checkbox", "id": "secondary_new_tab", "label": "Open in new tab", "default": false },
    { "type": "color", "id": "secondary_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "secondary_color", "label": "Text color", "default": "#28344e" },
    { "type": "color", "id": "secondary_border", "label": "Border color", "default": "#dce4ee" },
    { "type": "range", "id": "secondary_border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "secondary_radius", "label": "Radius", "min": 0, "max": 40, "step": 1, "default": 30, "unit": "px" },
    { "type": "range", "id": "secondary_size", "label": "Font size", "min": 11, "max": 20, "step": 1, "default": 13, "unit": "px" },
    { "type": "select", "id": "secondary_weight", "label": "Font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "600" },
    { "type": "range", "id": "secondary_padding", "label": "Horizontal padding", "min": 10, "max": 40, "step": 1, "default": 18, "unit": "px" },
    { "type": "color", "id": "secondary_hover_background", "label": "Hover background", "default": "#eff3fa" },
    { "type": "color", "id": "secondary_hover_color", "label": "Hover text", "default": "#1d2c52" },
    { "type": "header", "content": "Primary button" },
    { "type": "checkbox", "id": "show_primary", "label": "Show primary button", "default": true },
    { "type": "text", "id": "primary_text", "label": "Text", "default": "Book a Strategy Call" },
    { "type": "url", "id": "primary_link", "label": "Link" },
    { "type": "checkbox", "id": "primary_new_tab", "label": "Open in new tab", "default": false },
    { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": false },
    { "type": "color", "id": "primary_background", "label": "Background", "default": "#f47722" },
    { "type": "color", "id": "primary_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "primary_hover_background", "label": "Hover background", "default": "#db5b17" },
    { "type": "color", "id": "primary_hover_color", "label": "Hover text", "default": "#ffffff" },
    { "type": "range", "id": "primary_radius", "label": "Radius", "min": 0, "max": 40, "step": 1, "default": 30, "unit": "px" },
    { "type": "range", "id": "primary_size", "label": "Font size", "min": 11, "max": 20, "step": 1, "default": 13, "unit": "px" },
    { "type": "select", "id": "primary_weight", "label": "Font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "600" },
    { "type": "range", "id": "primary_padding", "label": "Horizontal padding", "min": 10, "max": 40, "step": 1, "default": 20, "unit": "px" },
    { "type": "checkbox", "id": "primary_shadow", "label": "Show button shadow", "default": false },
    { "type": "checkbox", "id": "primary_hover_shadow", "label": "Show hover shadow", "default": true }
  ],
  "presets": [{ "name": "Custom success CTA" }]
}
{% endschema %}

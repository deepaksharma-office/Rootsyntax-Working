{{ 'custom-why-choose.css' | asset_url | stylesheet_tag }}

{% liquid
  assign card_shadow = 'none'
  case section.settings.card_shadow
    when 'subtle'
      assign card_shadow = '0 3px 12px rgba(22, 39, 77, .04)'
    when 'medium'
      assign card_shadow = '0 10px 28px rgba(22, 39, 77, .1)'
  endcase
  assign hover_shadow = 'none'
  case section.settings.hover_shadow
    when 'subtle'
      assign hover_shadow = '0 8px 20px rgba(22, 39, 77, .09)'
    when 'medium'
      assign hover_shadow = '0 16px 34px rgba(22, 39, 77, .15)'
  endcase
%}

<section
  id="cust__why-choose-{{ section.id }}"
  class="cust__why-choose{% if section.settings.use_gradient %} cust__why-choose--gradient{% endif %}"
  style="
    --cust-section-bg: {{ section.settings.background_color }};
    --cust-gradient-color: {{ section.settings.gradient_color }};
    --cust-gradient-opacity: {{ section.settings.gradient_opacity | divided_by: 100.0 }};
    --cust-gradient-direction: {{ section.settings.gradient_direction }};
    --cust-max-width: {{ section.settings.max_width }}px;
    --cust-desktop-columns: {{ section.settings.desktop_columns }};
    --cust-tablet-columns: {{ section.settings.tablet_columns }};
    --cust-mobile-columns: {{ section.settings.mobile_columns }};
    --cust-card-gap: {{ section.settings.card_gap }}px;
    --cust-row-gap: {{ section.settings.row_gap }}px;
    --cust-padding-top: {{ section.settings.padding_top }}px;
    --cust-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cust-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --cust-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --cust-padding-sides: {{ section.settings.padding_sides }}px;
    --cust-eyebrow-bg: {{ section.settings.eyebrow_background }};
    --cust-eyebrow-color: {{ section.settings.eyebrow_text_color }};
    --cust-eyebrow-border: {{ section.settings.eyebrow_border_color }};
    --cust-eyebrow-border-width: {{ section.settings.eyebrow_border_width }}px;
    --cust-eyebrow-radius: {{ section.settings.eyebrow_radius }}px;
    --cust-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --cust-eyebrow-weight: {{ section.settings.eyebrow_font_weight }};
    --cust-eyebrow-padding-x: {{ section.settings.eyebrow_padding_horizontal }}px;
    --cust-eyebrow-padding-y: {{ section.settings.eyebrow_padding_vertical }}px;
    --cust-eyebrow-bottom-gap: {{ section.settings.eyebrow_bottom_spacing }}px;
    --cust-heading-color: {{ section.settings.heading_color }};
    --cust-heading-size: {{ section.settings.heading_font_size }}px;
    --cust-heading-mobile-size: {{ section.settings.heading_mobile_font_size }}px;
    --cust-heading-weight: {{ section.settings.heading_weight }};
    --cust-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --cust-heading-max-width: {{ section.settings.heading_max_width }}px;
    --cust-heading-bottom-gap: {{ section.settings.heading_bottom_spacing }}px;
    --cust-card-bg: {{ section.settings.card_background }};
    --cust-card-border: {{ section.settings.card_border_color }};
    --cust-card-border-width: {{ section.settings.card_border_width }}px;
    --cust-card-radius: {{ section.settings.card_radius }}px;
    --cust-card-shadow: {{ card_shadow }};
    --cust-card-padding: {{ section.settings.card_padding }}px;
    --cust-card-min-height: {{ section.settings.card_min_height }}px;
    --cust-hover-lift: {{ section.settings.hover_lift }}px;
    --cust-hover-shadow: {{ hover_shadow }};
    --cust-hover-border: {{ section.settings.hover_border_color }};
    --cust-glow-color: {{ section.settings.glow_color }};
    --cust-glow-opacity: {{ section.settings.glow_opacity | divided_by: 100.0 }};
    --cust-glow-hover-opacity: {{ section.settings.glow_hover_intensity | divided_by: 100.0 }};
    --cust-glow-size: {{ section.settings.glow_size }}px;
    --cust-glow-blur: {{ section.settings.glow_blur }}px;
    --cust-title-color: {{ section.settings.card_title_color }};
    --cust-title-size: {{ section.settings.card_title_size }}px;
    --cust-title-mobile-size: {{ section.settings.card_title_mobile_size }}px;
    --cust-title-weight: {{ section.settings.card_title_weight }};
    --cust-title-line-height: {{ section.settings.card_title_line_height | divided_by: 100.0 }};
    --cust-description-color: {{ section.settings.card_description_color }};
    --cust-description-size: {{ section.settings.card_description_size }}px;
    --cust-description-mobile-size: {{ section.settings.card_description_mobile_size }}px;
    --cust-description-line-height: {{ section.settings.card_description_line_height | divided_by: 100.0 }};
    --cust-proof-bg: {{ section.settings.proof_background }};
    --cust-proof-color: {{ section.settings.proof_text_color }};
    --cust-proof-border: {{ section.settings.proof_border_color }};
    --cust-proof-border-width: {{ section.settings.proof_border_width }}px;
    --cust-proof-radius: {{ section.settings.proof_radius }}px;
    --cust-proof-size: {{ section.settings.proof_font_size }}px;
    --cust-proof-padding: {{ section.settings.proof_padding }}px;
    --cust-proof-top-gap: {{ section.settings.proof_top_margin }}px;
    --cust-proof-icon-color: {{ section.settings.proof_icon_color }};
    --cust-proof-icon-size: {{ section.settings.proof_icon_size }}px;
  "
>
  <div class="cust__why-choose-inner">
    {% if section.settings.show_eyebrow or section.settings.heading != blank or section.settings.description != blank %}
      <header class="cust__why-choose-header">
        {% if section.settings.show_eyebrow and section.settings.eyebrow != blank %}
          <span class="cust__why-choose-eyebrow">
            {% if section.settings.eyebrow_icon != blank %}<span aria-hidden="true">{{ section.settings.eyebrow_icon | escape }}</span>{% endif %}
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="cust__why-choose-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="cust__why-choose-intro">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="cust__why-choose-grid">
        {% for block in section.blocks %}
          {% liquid
            assign linked_card = false
            if block.settings.link != blank and block.settings.clickable_card
              assign linked_card = true
            endif
            assign show_card_icon = true
            if block.settings.icon_type == 'none'
              assign show_card_icon = false
            elsif block.settings.icon_type == 'image' and block.settings.icon == blank
              assign show_card_icon = false
            endif
          %}
          {% if linked_card %}
            <a class="cust__why-choose-card{% if section.settings.card_hover %} cust__why-choose-card--hover{% endif %}"
              href="{{ block.settings.link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}
              style="
                --cust-block-bg: {% if block.settings.custom_card_background %}{{ block.settings.card_background }}{% else %}var(--cust-card-bg){% endif %};
                --cust-block-glow: {% if block.settings.custom_glow %}{{ block.settings.glow_color }}{% else %}var(--cust-glow-color){% endif %};
                --cust-block-title: {{ block.settings.title_color | default: section.settings.card_title_color }};
                --cust-block-description: {{ block.settings.description_color | default: section.settings.card_description_color }};
              " {{ block.shopify_attributes }}>
          {% else %}
            <article class="cust__why-choose-card{% if section.settings.card_hover %} cust__why-choose-card--hover{% endif %}"
              style="
                --cust-block-bg: {% if block.settings.custom_card_background %}{{ block.settings.card_background }}{% else %}var(--cust-card-bg){% endif %};
                --cust-block-glow: {% if block.settings.custom_glow %}{{ block.settings.glow_color }}{% else %}var(--cust-glow-color){% endif %};
                --cust-block-title: {{ block.settings.title_color | default: section.settings.card_title_color }};
                --cust-block-description: {{ block.settings.description_color | default: section.settings.card_description_color }};
              " {{ block.shopify_attributes }}>
          {% endif %}
            {% if section.settings.enable_glow %}
              <span class="cust__why-choose-glow cust__why-choose-glow--{{ section.settings.glow_position }}" aria-hidden="true"></span>
            {% endif %}
            {% if show_card_icon %}
              <span class="cust__why-choose-icon" style="--cust-icon-size: {{ block.settings.icon_size }}px; --cust-icon-bg: {{ block.settings.icon_background }};" aria-hidden="true">
                {% case block.settings.icon_type %}
                  {% when 'image' %}
                    {% if block.settings.icon != blank %}
                      {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', widths: '40, 80, 120', alt: '' }}
                    {% endif %}
                  {% when 'emoji' %}
                    {{ block.settings.icon_character | escape }}
                  {% when 'text' %}
                    {{ block.settings.icon_character | escape }}
                {% endcase %}
              </span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="cust__why-choose-card-title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="cust__why-choose-card-description">{{ block.settings.description | escape | newline_to_br }}</p>
            {% endif %}
          {% if linked_card %}</a>{% else %}</article>{% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_proof and section.settings.proof_text != blank %}
      <div class="cust__why-choose-proof">
        {% if section.settings.show_proof_icon and section.settings.proof_icon != blank %}
          <span class="cust__why-choose-proof-icon" aria-hidden="true">{{ section.settings.proof_icon | escape }}</span>
        {% endif %}
        <span>{{ section.settings.proof_text | escape }}</span>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom why choose us",
  "tag": "section",
  "class": "section-custom-why-choose",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Why Choose Us" },
    { "type": "text", "id": "eyebrow_icon", "label": "Eyebrow icon or character", "default": "✦" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Ecommerce Brands Choose RootSyntax" },
    { "type": "richtext", "id": "description", "label": "Section description" },
    { "type": "range", "id": "max_width", "label": "Content maximum width", "min": 600, "max": 1600, "step": 20, "default": 1200, "unit": "px" },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "tablet_columns", "label": "Tablet columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "range", "id": "card_gap", "label": "Column gap", "min": 0, "max": 60, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "row_gap", "label": "Row gap", "min": 0, "max": 60, "step": 2, "default": 16, "unit": "px" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "default": 56, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "default": 56, "unit": "px" },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 120, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "padding_sides", "label": "Horizontal padding", "min": 0, "max": 80, "step": 2, "default": 24, "unit": "px" },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "checkbox", "id": "use_gradient", "label": "Use background gradient", "default": false },
    { "type": "color", "id": "gradient_color", "label": "Gradient color", "default": "#f4f7ff" },
    { "type": "range", "id": "gradient_opacity", "label": "Gradient opacity", "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "select", "id": "gradient_direction", "label": "Gradient direction", "options": [{ "value": "to right", "label": "Left to right" }, { "value": "to left", "label": "Right to left" }, { "value": "to bottom", "label": "Top to bottom" }, { "value": "to top", "label": "Bottom to top" }], "default": "to bottom" },
    { "type": "header", "content": "Eyebrow style" },
    { "type": "color", "id": "eyebrow_background", "label": "Background", "default": "#f9fbfe" },
    { "type": "color", "id": "eyebrow_text_color", "label": "Text color", "default": "#425b8e" },
    { "type": "color", "id": "eyebrow_border_color", "label": "Border color", "default": "#e4e9f2" },
    { "type": "range", "id": "eyebrow_border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "eyebrow_radius", "label": "Corner radius", "min": 0, "max": 50, "step": 1, "default": 30, "unit": "px" },
    { "type": "range", "id": "eyebrow_font_size", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 11, "unit": "px" },
    { "type": "select", "id": "eyebrow_font_weight", "label": "Font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi bold" }, { "value": "700", "label": "Bold" }], "default": "500" },
    { "type": "range", "id": "eyebrow_padding_horizontal", "label": "Horizontal padding", "min": 4, "max": 30, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "eyebrow_padding_vertical", "label": "Vertical padding", "min": 2, "max": 16, "step": 1, "default": 4, "unit": "px" },
    { "type": "range", "id": "eyebrow_bottom_spacing", "label": "Space below eyebrow", "min": 0, "max": 60, "step": 2, "default": 14, "unit": "px" },
    { "type": "header", "content": "Heading style" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#263140" },
    { "type": "range", "id": "heading_font_size", "label": "Desktop heading size", "min": 24, "max": 72, "step": 1, "default": 42, "unit": "px" },
    { "type": "range", "id": "heading_mobile_font_size", "label": "Mobile heading size", "min": 18, "max": 48, "step": 1, "default": 28, "unit": "px" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }], "default": "700" },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 100, "max": 160, "step": 5, "default": 115, "unit": "%" },
    { "type": "range", "id": "heading_max_width", "label": "Heading maximum width", "min": 300, "max": 1000, "step": 10, "default": 700, "unit": "px" },
    { "type": "range", "id": "heading_bottom_spacing", "label": "Space below heading", "min": 0, "max": 100, "step": 2, "default": 28, "unit": "px" },
    { "type": "header", "content": "Card appearance" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f9fafc" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#e5e9f1" },
    { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 1, "default": 16, "unit": "px" },
    { "type": "select", "id": "card_shadow", "label": "Card shadow", "options": [{ "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "medium", "label": "Medium" }], "default": "none" },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 8, "max": 50, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 140, "max": 400, "step": 10, "default": 230, "unit": "px" },
    { "type": "checkbox", "id": "card_hover", "label": "Enable card hover effect", "default": true },
    { "type": "range", "id": "hover_lift", "label": "Hover lift", "min": 0, "max": 16, "step": 1, "default": 3, "unit": "px" },
    { "type": "select", "id": "hover_shadow", "label": "Hover shadow", "options": [{ "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "medium", "label": "Medium" }], "default": "subtle" },
    { "type": "color", "id": "hover_border_color", "label": "Hover border color", "default": "#cbd6eb" },
    { "type": "header", "content": "Card glow" },
    { "type": "checkbox", "id": "enable_glow", "label": "Enable card glow", "default": true },
    { "type": "color", "id": "glow_color", "label": "Glow color", "default": "#bbcdf5" },
    { "type": "range", "id": "glow_opacity", "label": "Glow opacity", "min": 0, "max": 100, "step": 5, "default": 20, "unit": "%" },
    { "type": "range", "id": "glow_size", "label": "Glow size", "min": 40, "max": 300, "step": 10, "default": 140, "unit": "px" },
    { "type": "range", "id": "glow_blur", "label": "Glow blur", "min": 0, "max": 100, "step": 2, "default": 46, "unit": "px" },
    { "type": "select", "id": "glow_position", "label": "Glow position", "options": [{ "value": "top-right", "label": "Top right" }, { "value": "top-left", "label": "Top left" }, { "value": "center", "label": "Center" }, { "value": "bottom-right", "label": "Bottom right" }], "default": "top-right" },
    { "type": "range", "id": "glow_hover_intensity", "label": "Hover glow opacity", "min": 0, "max": 100, "step": 5, "default": 35, "unit": "%" },
    { "type": "header", "content": "Card typography" },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#203c78" },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 12, "max": 36, "step": 1, "default": 22, "unit": "px" },
    { "type": "range", "id": "card_title_mobile_size", "label": "Mobile title size", "min": 12, "max": 32, "step": 1, "default": 20, "unit": "px" },
    { "type": "select", "id": "card_title_weight", "label": "Card title weight", "options": [{ "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }], "default": "700" },
    { "type": "range", "id": "card_title_line_height", "label": "Title line height", "min": 100, "max": 160, "step": 5, "default": 115, "unit": "%" },
    { "type": "color", "id": "card_description_color", "label": "Card description color", "default": "#697588" },
    { "type": "range", "id": "card_description_size", "label": "Card description size", "min": 10, "max": 24, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "card_description_mobile_size", "label": "Mobile description size", "min": 10, "max": 24, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "card_description_line_height", "label": "Description line height", "min": 100, "max": 200, "step": 5, "default": 145, "unit": "%" },
    { "type": "header", "content": "Social proof pill" },
    { "type": "checkbox", "id": "show_proof", "label": "Show social proof", "default": true },
    { "type": "text", "id": "proof_text", "label": "Social proof text", "default": "Join 500+ innovative companies growing with RootSyntax" },
    { "type": "color", "id": "proof_background", "label": "Background", "default": "#f9fbfe" },
    { "type": "color", "id": "proof_text_color", "label": "Text color", "default": "#536176" },
    { "type": "color", "id": "proof_border_color", "label": "Border color", "default": "#e4e9f2" },
    { "type": "range", "id": "proof_border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "proof_radius", "label": "Corner radius", "min": 0, "max": 50, "step": 1, "default": 40, "unit": "px" },
    { "type": "range", "id": "proof_font_size", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "proof_padding", "label": "Padding", "min": 4, "max": 24, "step": 1, "default": 10, "unit": "px" },
    { "type": "range", "id": "proof_top_margin", "label": "Top margin", "min": 0, "max": 100, "step": 2, "default": 28, "unit": "px" },
    { "type": "checkbox", "id": "show_proof_icon", "label": "Show icon", "default": true },
    { "type": "text", "id": "proof_icon", "label": "Icon or character", "default": "•••" },
    { "type": "color", "id": "proof_icon_color", "label": "Icon color", "default": "#5579bc" },
    { "type": "range", "id": "proof_icon_size", "label": "Icon size", "min": 10, "max": 30, "step": 1, "default": 18, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Describe this benefit." },
        { "type": "select", "id": "icon_type", "label": "Icon type", "options": [{ "value": "none", "label": "None" }, { "value": "image", "label": "Image" }, { "value": "emoji", "label": "Emoji" }, { "value": "text", "label": "Text" }], "default": "none" },
        { "type": "image_picker", "id": "icon", "label": "Icon image" },
        { "type": "text", "id": "icon_character", "label": "Icon or emoji character", "default": "✦" },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 20, "max": 100, "step": 2, "default": 40, "unit": "px" },

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 24px;
    background: #ffffff;
    color: #252923;
    font-family: Arial, Helvetica, sans-serif;
    box-sizing: border-box;
  }
  .ai-pricing-{{ ai_gen_id }} *, .ai-pricing-{{ ai_gen_id }} *::before, .ai-pricing-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-pricing-{{ ai_gen_id }}__inner { max-width: 1240px; margin: 0 auto; }
  .ai-pricing-{{ ai_gen_id }}__eyebrow { display: flex; align-items: center; gap: 9px; color: #17364b; font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__dot { width: 7px; height: 7px; border-radius: 50%; background: #397db2; flex: 0 0 7px; }
  .ai-pricing-{{ ai_gen_id }}__title { margin: 22px 0 26px; font-size: clamp(38px, 5.15vw, 64px); line-height: 1.04; letter-spacing: -.045em; font-weight: 400; }
  .ai-pricing-{{ ai_gen_id }}__title span { display: block; }
  .ai-pricing-{{ ai_gen_id }}__title em { color: #ed6b19; font-style: italic; font-weight: 400; }
  .ai-pricing-{{ ai_gen_id }}__rule { border: 0; border-top: 1px solid #e1e5e3; margin: 0; }
  .ai-pricing-{{ ai_gen_id }}__meta { display: flex; justify-content: space-between; align-items: center; gap: 18px; margin: 18px 0 26px; }
  .ai-pricing-{{ ai_gen_id }}__pill { padding: 8px 13px; border-radius: 999px; color: #3d5868; background: #edf2f4; font-size: 12px; }
  .ai-pricing-{{ ai_gen_id }}__currency { color: #727a78; font-size: 12px; text-align: right; }
  .ai-pricing-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .ai-pricing-{{ ai_gen_id }}__card { display: flex; flex-direction: column; min-width: 0; padding: 27px 25px 23px; border: 1px solid #e1e4e2; border-radius: 8px; background: #f6f7f6; color: #252923; }
  .ai-pricing-{{ ai_gen_id }}__card--featured { background: #1f251e; border-color: #1f251e; color: #ffffff; }
  .ai-pricing-{{ ai_gen_id }}__card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; min-height: 19px; }
  .ai-pricing-{{ ai_gen_id }}__label { color: #21475f; font-size: 10px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__label { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__badge { padding: 6px 9px; border-radius: 999px; background: #ff7414; color: #22251f; font-size: 9px; font-weight: 800; letter-spacing: .07em; white-space: nowrap; }
  .ai-pricing-{{ ai_gen_id }}__name { margin: 18px 0 5px; font-size: 27px; line-height: 1.15; font-weight: 500; letter-spacing: -.025em; }
  .ai-pricing-{{ ai_gen_id }}__description { min-height: 40px; margin: 0; color: #626a67; font-size: 13px; line-height: 1.55; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__description { color: #c4c9c4; }
  .ai-pricing-{{ ai_gen_id }}__price { margin: 23px 0 3px; font-size: 42px; line-height: 1; font-weight: 500; letter-spacing: -.045em; }
  .ai-pricing-{{ ai_gen_id }}__price-note { margin: 0 0 20px; color: #747c78; font-size: 11px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__price-note { color: #c4c9c4; }
  .ai-pricing-{{ ai_gen_id }}__button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 46px; padding: 0 14px; border: 1px solid #2e3831; border-radius: 4px; background: #ffffff; color: #242924; font-size: 13px; font-weight: 600; text-decoration: none; }
  .ai-pricing-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #397db2; outline-offset: 3px; }
  .ai-pricing-{{ ai_gen_id }}__button--featured { border-color: #ff7414; background: #ff7414; color: #20241f; }
  .ai-pricing-{{ ai_gen_id }}__arrow { font-size: 18px; line-height: 1; }
  .ai-pricing-{{ ai_gen_id }}__divider { width: 100%; border: 0; border-top: 1px solid #dfe3e1; margin: 20px 0 17px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__divider { border-color: #41483f; }
  .ai-pricing-{{ ai_gen_id }}__features-title { margin: 0 0 12px; font-size: 10px; line-height: 1.4; font-weight: 800; letter-spacing: .09em; }
  .ai-pricing-{{ ai_gen_id }}__features { display: grid; gap: 9px; padding: 0; margin: 0; list-style: none; }
  .ai-pricing-{{ ai_gen_id }}__feature { display: grid; grid-template-columns: 14px 1fr; gap: 7px; font-size: 11px; line-height: 1.45; color: #454d49; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__feature { color: #e4e8e3; }
  .ai-pricing-{{ ai_gen_id }}__check { color: #347aa6; font-weight: 800; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__check { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__delivery { margin: auto 0 0; padding-top: 23px; font-size: 11px; line-height: 1.45; font-weight: 700; }
  .ai-pricing-{{ ai_gen_id }}__note { margin: 21px 0 0; color: #777e7b; font-size: 11px; line-height: 1.5; text-align: center; }
  @media screen and (max-width: 749px) {
    .ai-pricing-{{ ai_gen_id }} { padding: 44px 20px; }
    .ai-pricing-{{ ai_gen_id }}__title { margin: 19px 0 22px; }
    .ai-pricing-{{ ai_gen_id }}__meta { align-items: flex-start; flex-direction: column; gap: 10px; margin: 15px 0 22px; }
    .ai-pricing-{{ ai_gen_id }}__currency { text-align: left; }
    .ai-pricing-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 14px; }
    .ai-pricing-{{ ai_gen_id }}__card { padding: 24px 22px 21px; }
    .ai-pricing-{{ ai_gen_id }}__description { min-height: 0; }
    .ai-pricing-{{ ai_gen_id }}__delivery { padding-top: 22px; }
  }
{% endstyle %}


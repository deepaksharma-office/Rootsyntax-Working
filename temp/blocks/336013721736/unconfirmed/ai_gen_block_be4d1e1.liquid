{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background }};
    color: #20241f;
    padding: 60px 20px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
  }
  .ai-pricing-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-pricing-{{ ai_gen_id }}__inner { width: {{ block.settings.desktop_width_percent }}%; max-width: 1240px; margin: 0 auto; }
  .ai-pricing-{{ ai_gen_id }}__eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: #243b57; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__dot { width: 6px; height: 6px; border-radius: 50%; background: #3885c8; flex: 0 0 auto; }
  .ai-pricing-{{ ai_gen_id }}__title { margin: 0; color: #282b29; font-size: 64px; line-height: .99; letter-spacing: -.045em; font-weight: 400; }
  .ai-pricing-{{ ai_gen_id }}__title-accent { display: block; color: {{ block.settings.accent_color }}; font-style: italic; }
  .ai-pricing-{{ ai_gen_id }}__rule { border: 0; border-top: 1px solid #e1e4e1; margin: 34px 0 22px; }
  .ai-pricing-{{ ai_gen_id }}__meta { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 26px; }
  .ai-pricing-{{ ai_gen_id }}__pill { display: inline-flex; padding: 8px 13px; border-radius: 99px; background: #edf2f4; color: #52616b; font-size: 12px; font-weight: 600; }
  .ai-pricing-{{ ai_gen_id }}__currency { margin: 0; color: #727976; font-size: 12px; }
  .ai-pricing-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .ai-pricing-{{ ai_gen_id }}__card { min-width: 0; min-height: 100%; display: flex; flex-direction: column; padding: 28px; border: 1px solid #e1e4e1; border-radius: 8px; background: #f6f7f6; color: #252925; }
  .ai-pricing-{{ ai_gen_id }}__card--featured { background: #1f251e; border-color: #1f251e; color: #fff; }
  .ai-pricing-{{ ai_gen_id }}__topline { min-height: 21px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .ai-pricing-{{ ai_gen_id }}__label { margin: 0; color: #243b57; font-size: 10px; line-height: 1.4; font-weight: 700; letter-spacing: .1em; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__label { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__badge { flex: 0 0 auto; padding: 6px 9px; border-radius: 99px; background: #ff7414; color: #20241f; font-size: 9px; line-height: 1; font-weight: 800; letter-spacing: .06em; }
  .ai-pricing-{{ ai_gen_id }}__name { margin: 20px 0 7px; font-size: 27px; line-height: 1.1; font-weight: 500; letter-spacing: -.03em; }
  .ai-pricing-{{ ai_gen_id }}__description { min-height: 42px; margin: 0; color: #68706b; font-size: 13px; line-height: 1.55; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__description { color: #c0c5bf; }
  .ai-pricing-{{ ai_gen_id }}__price { margin: 25px 0 3px; font-size: 42px; line-height: 1; font-weight: 500; letter-spacing: -.045em; }
  .ai-pricing-{{ ai_gen_id }}__price-note { margin: 0; color: #747b76; font-size: 11px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__price-note { color: #b8bdb8; }
  .ai-pricing-{{ ai_gen_id }}__button { min-height: 48px; width: 100%; margin: 23px 0 20px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid #303630; border-radius: 4px; background: #fff; color: #242924; text-decoration: none; font-size: 13px; font-weight: 650; }
  .ai-pricing-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #4385bd; outline-offset: 3px; }
  .ai-pricing-{{ ai_gen_id }}__button--featured { border-color: #ff7414; background: #ff7414; color: #20241f; }
  .ai-pricing-{{ ai_gen_id }}__arrow { font-size: 18px; line-height: 1; }
  .ai-pricing-{{ ai_gen_id }}__divider { width: 100%; border: 0; border-top: 1px solid #dfe2df; margin: 0 0 19px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__divider { border-color: #414740; }
  .ai-pricing-{{ ai_gen_id }}__features-title { margin: 0 0 13px; font-size: 10px; line-height: 1.4; font-weight: 800; letter-spacing: .09em; }
  .ai-pricing-{{ ai_gen_id }}__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .ai-pricing-{{ ai_gen_id }}__feature { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 7px; font-size: 11px; line-height: 1.45; }
  .ai-pricing-{{ ai_gen_id }}__check { color: #387eb6; font-weight: 800; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__check { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__delivery { margin: auto 0 0; padding-top: 24px; font-size: 11px; line-height: 1.4; font-weight: 700; }
  .ai-pricing-{{ ai_gen_id }}__note { max-width: 760px; margin: 23px auto 0; color: #777e79; text-align: center; font-size: 11px; line-height: 1.55; }
  @media (max-width: 749px) {
    .ai-pricing-{{ ai_gen_id }} { padding: 44px 20px; }
    .ai-pricing-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-pricing-{{ ai_gen_id }}__title { font-size: 38px; line-height: 1.03; }
    .ai-pricing-{{ ai_gen_id }}__rule { margin: 25px 0 17px; }
    .ai-pricing-{{ ai_gen_id }}__meta { align-items: flex-start; flex-direction: column; gap: 10px; margin-bottom: 20px; }
    .ai-pricing-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 14px; }
    .ai-pricing-{{ ai_gen_id }}__card { padding: 24px; }
  }
{% endstyle %}

<div class="ai-pricing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-{{ ai_gen_id }}__inner">
    <p class="ai-pricing-{{ ai_gen_id }}__eyebrow"><span class="ai-pricing-{{ ai_gen_id }}__dot" aria-hidden="true"></span>{{ block.settings.eyebrow | escape }}</p>
    <h2 class="ai-pricing-{{ ai_gen_id }}__title">{{ block.settings.title_first | escape }}<span class="ai-pricing-{{ ai_gen_id }}__title-accent">{{ block.settings.title_second | escape }}</span></h2>
    <hr class="ai-pricing-{{ ai_gen_id }}__rule">
    <div class="ai-pricing-{{ ai_gen_id }}__meta">
      <span class="ai-pricing-{{ ai_gen_id }}__pill">{{ block.settings.pricing_pill | escape }}</span>
      <p class="ai-pricing-{{ ai_gen_id }}__currency">{{ block.settings.currency_note | escape }}</p>
    </div>
    <div class="ai-pricing-{{ ai_gen_id }}__grid">
      {% for i in (1..3) %}
        {% liquid
          assign prefix = 'plan_' | append: i | append: '_'
          assign name_key = prefix | append: 'name'
          assign label_key = prefix | append: 'label'
          assign description_key = prefix | append: 'description'
          assign price_key = prefix | append: 'price'
          assign cta_key = prefix | append: 'button'
          assign link_key = prefix | append: 'link'
          assign title_key = prefix | append: 'features_title'
          assign features_key = prefix | append: 'features'
          assign delivery_key = prefix | append: 'delivery'
          assign name = block.settings[name_key]
          assign label = block.settings[label_key]
          assign description = block.settings[description_key]
          assign price = block.settings[price_key]
          assign cta = block.settings[cta_key]
          assign link = block.settings[link_key]
          assign features_title = block.settings[title_key]
          assign features = block.settings[features_key] | newline_to_br | split: '<br />'
          assign delivery = block.settings[delivery_key]
        %}
        <article class="ai-pricing-{{ ai_gen_id }}__card{% if i == 2 %} ai-pricing-{{ ai_gen_id }}__card--featured{% endif %}">
          <div class="ai-pricing-{{ ai_gen_id }}__topline">
            <p class="ai-pricing-{{ ai_gen_id }}__label">{{ label | escape }}</p>
            {% if i == 2 %}<span class="ai-pricing-{{ ai_gen_id }}__badge">{{ block.settings.featured_badge | escape }}</span>{% endif %}
          </div>
          <h3 class="ai-pricing-{{ ai_gen_id }}__name">{{ name | escape }}</h3>
          <p class="ai-pricing-{{ ai_gen_id }}__description">{{ description | escape }}</p>
          <p class="ai-pricing-{{ ai_gen_id }}__price">{{ price | escape }}</p>
          <p class="ai-pricing-{{ ai_gen_id }}__price-note">{{ block.settings.price_note | escape }}</p>
          <a class="ai-pricing-{{ ai_gen_id }}__button{% if i == 2 %} ai-pricing-{{ ai_gen_id }}__button--featured{% endif %}" href="{{ link | default: '#' }}"{% if link == blank %} aria-label="{{ cta | escape }} (link not set)"{% endif %}>
            <span>{{ cta | escape }}</span><span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span>
          </a>
          <hr class="ai-pricing-{{ ai_gen_id }}__divider">
          <h4 class="ai-pricing-{{ ai_gen_id }}__features-title">{{ features_title | escape }}</h4>
          <ul class="ai-pricing-{{ ai_gen_id }}__features">
            {% for feature in features %}
              {% assign feature_text = feature | strip %}
              {% if feature_text != blank %}<li class="ai-pricing-{{ ai_gen_id }}__feature"><span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span><span>{{ feature_text | escape }}</span></li>{% endif %}
            {% endfor %}
          </ul>
          <p class="ai-pricing-{{ ai_gen_id }}__delivery">{{ delivery | escape }}</p>
        </article>
      {% endfor %}
    </div>
    <p class="ai-pricing-{{ ai_gen_id }}__note">{{ block.settings.bottom_note | escape }}</p>
  </div>
</div>


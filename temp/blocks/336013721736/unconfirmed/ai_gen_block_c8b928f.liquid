    { "type": "url", "id": "launch_link", "label": "Launch link" },
    { "type": "text", "id": "growth_button", "label": "Growth button", "default": "Choose Growth" },
    { "type": "url", "id": "growth_link", "label": "Growth link" },
    { "type": "text", "id": "scale_button", "label": "Scale button", "default": "Choose Scale" },
    { "type": "url", "id": "scale_link", "label": "Scale link" },

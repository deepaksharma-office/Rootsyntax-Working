{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 20px;
    color: #252923;
    background: #ffffff;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    box-sizing: border-box;
  }
  .ai-pricing-{{ ai_gen_id }} *, .ai-pricing-{{ ai_gen_id }} *::before, .ai-pricing-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-pricing-{{ ai_gen_id }}__inner { max-width: 1240px; margin: 0 auto; }
  .ai-pricing-{{ ai_gen_id }}__eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: #223a59; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #4d8fce; }
  .ai-pricing-{{ ai_gen_id }}__heading { margin: 0; color: #272a28; font-size: clamp(38px, 5.2vw, 64px); line-height: 1.04; font-weight: 400; letter-spacing: -.045em; }
  .ai-pricing-{{ ai_gen_id }}__heading em { color: #f27628; font-weight: 400; }
  .ai-pricing-{{ ai_gen_id }}__rule { border: 0; border-top: 1px solid #e1e4e2; margin: 28px 0 20px; }
  .ai-pricing-{{ ai_gen_id }}__meta { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
  .ai-pricing-{{ ai_gen_id }}__pill { display: inline-block; padding: 8px 13px; border-radius: 30px; background: #edf2f5; color: #354857; font-size: 12px; line-height: 1.2; }
  .ai-pricing-{{ ai_gen_id }}__currency { margin: 0; color: #707875; font-size: 12px; text-align: right; }
  .ai-pricing-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .ai-pricing-{{ ai_gen_id }}__card { display: flex; flex-direction: column; min-width: 0; padding: 28px; border: 1px solid #e1e4e2; border-radius: 8px; background: #f6f7f6; color: #282c29; }
  .ai-pricing-{{ ai_gen_id }}__card--featured { border-color: #1f251e; background: #1f251e; color: #ffffff; }
  .ai-pricing-{{ ai_gen_id }}__label-row { min-height: 20px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .ai-pricing-{{ ai_gen_id }}__label { margin: 0; color: #263c58; font-size: 10px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__label { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__badge { padding: 6px 9px; border-radius: 20px; background: #ff7414; color: #20241f; font-size: 9px; font-weight: 800; letter-spacing: .06em; white-space: nowrap; }
  .ai-pricing-{{ ai_gen_id }}__title { margin: 21px 0 5px; color: inherit; font-size: 30px; line-height: 1.1; font-weight: 500; letter-spacing: -.035em; }
  .ai-pricing-{{ ai_gen_id }}__description { min-height: 42px; margin: 0; color: inherit; opacity: .78; font-size: 13px; line-height: 1.55; }
  .ai-pricing-{{ ai_gen_id }}__price { margin: 22px 0 2px; color: inherit; font-size: 42px; line-height: 1; font-weight: 500; letter-spacing: -.04em; }
  .ai-pricing-{{ ai_gen_id }}__unit { margin: 0 0 20px; color: inherit; opacity: .68; font-size: 11px; line-height: 1.5; }
  .ai-pricing-{{ ai_gen_id }}__button { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 48px; padding: 12px 15px; border: 1px solid #303631; border-radius: 4px; background: #ffffff; color: #252923; font: inherit; font-size: 13px; font-weight: 600; text-decoration: none; }
  .ai-pricing-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #4d8fce; outline-offset: 3px; }
  .ai-pricing-{{ ai_gen_id }}__button--featured { border-color: #ff7414; background: #ff7414; color: #20241f; }
  .ai-pricing-{{ ai_gen_id }}__arrow { font-size: 18px; line-height: 1; }
  .ai-pricing-{{ ai_gen_id }}__divider { width: 100%; border: 0; border-top: 1px solid #d9ddda; margin: 22px 0 18px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__divider { border-color: rgba(255,255,255,.2); }
  .ai-pricing-{{ ai_gen_id }}__features-title { margin: 0 0 14px; color: inherit; font-size: 10px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__features { display: flex; flex-direction: column; gap: 9px; margin: 0; padding: 0; list-style: none; }
  .ai-pricing-{{ ai_gen_id }}__features li { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 7px; color: inherit; font-size: 11px; line-height: 1.4; }
  .ai-pricing-{{ ai_gen_id }}__check { color: #3676b8; font-weight: 800; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__check { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__delivery { margin: auto 0 0; padding-top: 24px; color: inherit; font-size: 11px; line-height: 1.4; font-weight: 700; }
  .ai-pricing-{{ ai_gen_id }}__note { max-width: 780px; margin: 24px auto 0; color: #717875; font-size: 11px; line-height: 1.5; text-align: center; }
  @media screen and (max-width: 749px) {
    .ai-pricing-{{ ai_gen_id }} { width: 100%; padding: 42px 20px; }
    .ai-pricing-{{ ai_gen_id }}__eyebrow { margin-bottom: 18px; }
    .ai-pricing-{{ ai_gen_id }}__heading { font-size: 38px; }
    .ai-pricing-{{ ai_gen_id }}__rule { margin: 22px 0 16px; }
    .ai-pricing-{{ ai_gen_id }}__meta { align-items: flex-start; flex-direction: column; gap: 10px; margin-bottom: 20px; }
    .ai-pricing-{{ ai_gen_id }}__currency { text-align: left; }
    .ai-pricing-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 14px; }
    .ai-pricing-{{ ai_gen_id }}__card { padding: 24px; }
    .ai-pricing-{{ ai_gen_id }}__description { min-height: 0; }
  }
{% endstyle %}


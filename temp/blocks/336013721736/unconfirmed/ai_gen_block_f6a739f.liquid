{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pricing-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 24px;
    color: #252923;
    background: #ffffff;
    font-family: Inter, Arial, sans-serif;
  }
  .ai-pricing-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-pricing-{{ ai_gen_id }}__inner { max-width: 1240px; margin: 0 auto; }
  .ai-pricing-{{ ai_gen_id }}__eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 20px; color: #193b60; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #3685c6; }
  .ai-pricing-{{ ai_gen_id }}__heading { margin: 0; color: #272b27; font-size: clamp(38px, 5.2vw, 64px); font-weight: 400; letter-spacing: -.045em; line-height: 1.04; }
  .ai-pricing-{{ ai_gen_id }}__heading em { display: block; color: #f47721; font-weight: 400; }
  .ai-pricing-{{ ai_gen_id }}__rule { height: 1px; margin: 28px 0 18px; border: 0; background: #e3e5e2; }
  .ai-pricing-{{ ai_gen_id }}__meta { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 26px; }
  .ai-pricing-{{ ai_gen_id }}__pill { padding: 8px 13px; border-radius: 99px; background: #edf2f6; color: #344657; font-size: 12px; }
  .ai-pricing-{{ ai_gen_id }}__currency { margin: 0; color: #707771; font-size: 12px; }
  .ai-pricing-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .ai-pricing-{{ ai_gen_id }}__card { display: flex; min-width: 0; flex-direction: column; padding: 27px; border: 1px solid #e0e2df; border-radius: 8px; background: #f7f8f7; }
  .ai-pricing-{{ ai_gen_id }}__card--featured { border-color: #1f251e; background: #1f251e; color: #fff; }
  .ai-pricing-{{ ai_gen_id }}__card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 22px; }
  .ai-pricing-{{ ai_gen_id }}__label { margin: 0; color: #193b60; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__label { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__badge { padding: 6px 8px; border-radius: 99px; background: #ff7414; color: #1f251e; font-size: 9px; font-weight: 800; letter-spacing: .04em; white-space: nowrap; }
  .ai-pricing-{{ ai_gen_id }}__title { margin: 22px 0 6px; font-size: 30px; font-weight: 500; letter-spacing: -.035em; line-height: 1.1; }
  .ai-pricing-{{ ai_gen_id }}__description { min-height: 40px; margin: 0; color: #626963; font-size: 13px; line-height: 1.55; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__description { color: #c3c8c2; }
  .ai-pricing-{{ ai_gen_id }}__price { margin: 22px 0 3px; font-size: 42px; font-weight: 500; letter-spacing: -.05em; line-height: 1; }
  .ai-pricing-{{ ai_gen_id }}__price-note { margin: 0 0 19px; color: #727973; font-size: 11px; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__price-note { color: #c3c8c2; }
  .ai-pricing-{{ ai_gen_id }}__button { display: flex; width: 100%; min-height: 47px; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 15px; border: 1px solid #343a35; border-radius: 4px; background: #fff; color: #252923; font-size: 13px; font-weight: 600; text-decoration: none; }
  .ai-pricing-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #3685c6; outline-offset: 3px; }
  .ai-pricing-{{ ai_gen_id }}__button--featured { border-color: #ff7414; background: #ff7414; color: #1f251e; }
  .ai-pricing-{{ ai_gen_id }}__arrow { font-size: 18px; line-height: 1; }
  .ai-pricing-{{ ai_gen_id }}__divider { width: 100%; height: 1px; margin: 21px 0 17px; border: 0; background: #dfe2df; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__divider { background: #414740; }
  .ai-pricing-{{ ai_gen_id }}__features-title { margin: 0 0 13px; font-size: 10px; font-weight: 700; letter-spacing: .09em; line-height: 1.4; }
  .ai-pricing-{{ ai_gen_id }}__features { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
  .ai-pricing-{{ ai_gen_id }}__features li { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 7px; color: #454c46; font-size: 11px; line-height: 1.45; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__features li { color: #e1e5df; }
  .ai-pricing-{{ ai_gen_id }}__check { color: #3278ac; font-size: 14px; font-weight: 700; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__check { color: #ff8a3d; }
  .ai-pricing-{{ ai_gen_id }}__delivery { margin: auto 0 0; padding-top: 23px; color: #242a25; font-size: 11px; font-weight: 700; line-height: 1.45; }
  .ai-pricing-{{ ai_gen_id }}__card--featured .ai-pricing-{{ ai_gen_id }}__delivery { color: #fff; }
  .ai-pricing-{{ ai_gen_id }}__note { margin: 23px 0 0; color: #747a75; font-size: 11px; line-height: 1.5; text-align: center; }
  @media screen and (max-width: 749px) {
    .ai-pricing-{{ ai_gen_id }} { padding: 40px 20px; }
    .ai-pricing-{{ ai_gen_id }}__meta { align-items: flex-start; flex-direction: column; gap: 9px; }
    .ai-pricing-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 14px; }
    .ai-pricing-{{ ai_gen_id }}__card { padding: 23px; }
    .ai-pricing-{{ ai_gen_id }}__description { min-height: 0; }
  }
{% endstyle %}

<div class="ai-pricing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pricing-{{ ai_gen_id }}__inner">
    <p class="ai-pricing-{{ ai_gen_id }}__eyebrow"><span class="ai-pricing-{{ ai_gen_id }}__dot" aria-hidden="true"></span>{{ block.settings.eyebrow | escape }}</p>
    <h2 class="ai-pricing-{{ ai_gen_id }}__heading">{{ block.settings.heading_first | escape }}<em>{{ block.settings.heading_second | escape }}</em></h2>
    <hr class="ai-pricing-{{ ai_gen_id }}__rule">
    <div class="ai-pricing-{{ ai_gen_id }}__meta"><span class="ai-pricing-{{ ai_gen_id }}__pill">{{ block.settings.pricing_label | escape }}</span><p class="ai-pricing-{{ ai_gen_id }}__currency">{{ block.settings.currency_note | escape }}</p></div>
    <div class="ai-pricing-{{ ai_gen_id }}__grid">
      {% for i in (1..3) %}
        {% liquid
          assign label_key = 'tier_' | append: i | append: '_label'
          assign title_key = 'tier_' | append: i | append: '_title'
          assign description_key = 'tier_' | append: i | append: '_description'
          assign price_key = 'tier_' | append: i | append: '_price'
          assign button_key = 'tier_' | append: i | append: '_button'
          assign link_key = 'tier_' | append: i | append: '_link'
          assign features_title_key = 'tier_' | append: i | append: '_features_title'
          assign features_key = 'tier_' | append: i | append: '_features'
          assign delivery_key = 'tier_' | append: i | append: '_delivery'
          assign tier_label = block.settings[label_key]
          assign tier_title = block.settings[title_key]
          assign tier_description = block.settings[description_key]
          assign tier_price = block.settings[price_key]
          assign tier_button = block.settings[button_key]
          assign tier_link = block.settings[link_key]
          assign features_title = block.settings[features_title_key]
          assign tier_features = block.settings[features_key] | newline_to_br | split: '<br />'
          assign tier_delivery = block.settings[delivery_key]
        %}
        <article class="ai-pricing-{{ ai_gen_id }}__card{% if i == 2 %} ai-pricing-{{ ai_gen_id }}__card--featured{% endif %}">
          <div class="ai-pricing-{{ ai_gen_id }}__card-top"><p class="ai-pricing-{{ ai_gen_id }}__label">{{ tier_label | escape }}</p>{% if i == 2 %}<span class="ai-pricing-{{ ai_gen_id }}__badge">{{ block.settings.featured_badge | escape }}</span>{% endif %}</div>
          <h3 class="ai-pricing-{{ ai_gen_id }}__title">{{ tier_title | escape }}</h3>
          <p class="ai-pricing-{{ ai_gen_id }}__description">{{ tier_description | escape }}</p>
          <p class="ai-pricing-{{ ai_gen_id }}__price">{{ tier_price | escape }}</p>
          <p class="ai-pricing-{{ ai_gen_id }}__price-note">{{ block.settings.price_note | escape }}</p>
          {% if tier_link != blank %}<a class="ai-pricing-{{ ai_gen_id }}__button{% if i == 2 %} ai-pricing-{{ ai_gen_id }}__button--featured{% endif %}" href="{{ tier_link }}"><span>{{ tier_button | escape }}</span><span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span></a>{% else %}<a class="ai-pricing-{{ ai_gen_id }}__button{% if i == 2 %} ai-pricing-{{ ai_gen_id }}__button--featured{% endif %}" href="#"><span>{{ tier_button | escape }}</span><span class="ai-pricing-{{ ai_gen_id }}__arrow" aria-hidden="true">↗</span></a>{% endif %}
          <hr class="ai-pricing-{{ ai_gen_id }}__divider">
          <h4 class="ai-pricing-{{ ai_gen_id }}__features-title">{{ features_title | escape }}</h4>
          <ul class="ai-pricing-{{ ai_gen_id }}__features">{% for feature in tier_features %}{% assign clean_feature = feature | strip %}{% if clean_feature != blank %}<li><span class="ai-pricing-{{ ai_gen_id }}__check" aria-hidden="true">✓</span><span>{{ clean_feature | escape }}</span></li>{% endif %}{% endfor %}</ul>
          <p class="ai-pricing-{{ ai_gen_id }}__delivery">{{ tier_delivery | escape }}</p>
        </article>
      {% endfor %}
    </div>
    <p class="ai-pricing-{{ ai_gen_id }}__note">{{ block.settings.bottom_note | escape }}</p>
  </div>
</div>

{% schema %}
